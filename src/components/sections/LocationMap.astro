---
import { CLINIC } from '../../data/clinic'
import HoursTable from '../ui/HoursTable.astro'

interface Props {
  lang?: 'en' | 'es'
}
const { lang = 'en' } = Astro.props

const heading = lang === 'es' ? 'Cómo Llegar' : 'Find Us'
const subheading = lang === 'es'
  ? 'Convenientemente ubicados en Oklahoma City'
  : 'Conveniently located in Oklahoma City'
const hoursLabel = lang === 'es' ? 'Horario de Atención' : 'Hours of Operation'
const directionsLabel = lang === 'es' ? 'Cómo llegar →' : 'Get Directions →'
---

<section class="py-16 lg:py-24 bg-neutral-50">
  <div class="container">
    <div class="text-center max-w-xl mx-auto mb-12">
      <h2 class="text-3xl lg:text-4xl font-display font-bold text-neutral-900 mb-4">{heading}</h2>
      <p class="text-neutral-600 text-lg">{subheading}</p>
    </div>

    <div class="grid lg:grid-cols-5 gap-8 items-start">
      <!-- Map embed (3/5 width on desktop) -->
      <div class="lg:col-span-3 rounded-2xl overflow-hidden border border-neutral-200 shadow-sm aspect-video lg:aspect-auto lg:h-96">
        <iframe
          title="Health Watch Medical Clinic location map"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3255.0!2d-97.581!3d35.490!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s1924+N+Portland+Ave%2C+Oklahoma+City%2C+OK+73107!5e0!3m2!1sen!2sus!4v1"
          width="100%"
          height="100%"
          style="border:0; min-height: 320px;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <!-- Info panel (2/5 width on desktop) -->
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-white rounded-2xl border border-neutral-200 p-6">
          <h3 class="font-display font-bold text-neutral-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Location
          </h3>
          <address class="not-italic text-neutral-600 text-sm leading-relaxed mb-4">
            {CLINIC.address.street}<br />
            {CLINIC.address.city}, {CLINIC.address.state} {CLINIC.address.zip}
          </address>
          <div class="flex flex-wrap gap-3 text-sm">
            <a href={`tel:${CLINIC.phoneE164}`} class="inline-flex items-center gap-1.5 text-primary font-semibold hover:underline">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {CLINIC.phone}
            </a>
            <a href={CLINIC.mapsDirectionsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-primary font-semibold hover:underline">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
              {directionsLabel}
            </a>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-neutral-200 p-6">
          <h3 class="font-display font-bold text-neutral-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {hoursLabel}
          </h3>
          <HoursTable />
        </div>
      </div>
    </div>
  </div>
</section>
