---
import { Image } from 'astro:assets'
import clinicExterior from '../../assets/images/clinic-exterior.png'
import { CLINIC } from '../../data/clinic'
import { route } from '../../data/routes'

interface Props {
  lang?: 'en' | 'es'
}
const { lang = 'en' } = Astro.props

// Derived from CLINIC.hours so the badge cannot drift from the hours table.
const staffedHours = CLINIC.hours.filter((h) => h.opens24)
const dayLabel = (h: (typeof CLINIC.hours)[number]) => (lang === 'es' ? h.dayEs : h.day).slice(0, 3)
const openLabel = `${lang === 'es' ? 'Abierto' : 'Open'} ${dayLabel(staffedHours[0])}\u2013${dayLabel(staffedHours[staffedHours.length - 1])}`
const openTimes = `${staffedHours[0].open} \u2013 ${staffedHours[0].close}`

const content = lang === 'es'
  ? {
      badge: 'Rápido · Personal · Atención Familiar',
      headlinePrefix: 'Atención rápida y personal para toda su',
      headlineAccent: 'familia.',
      subheadline: 'Una clínica familiar de propiedad local en Oklahoma City — con citas el mismo día, sin cita previa, y un equipo bilingüe que la trata con la urgencia y atención que merece.',
      cta: 'Hacer una cita',
      ctaPhone: 'Llamar',
      trustBadges: ['Citas el mismo día', 'Sin cita previa', 'Atención bilingüe', 'Aceptamos la mayoría de seguros'],
    }
  : {
      badge: 'Fast · Personal · Family Medical Care',
      headlinePrefix: 'Fast, personal care for your',
      headlineAccent: 'whole family.',
      subheadline: 'A locally owned family clinic in Oklahoma City — with same-day appointments, walk-ins welcome, and a caring bilingual team that treats you with the urgency and attention you deserve.',
      cta: 'Book an appointment',
      ctaPhone: 'Call',
      trustBadges: ['Same-day appointments', 'Walk-ins welcome', 'Bilingual care', 'Most insurance accepted'],
    }
---

<section class="relative overflow-hidden" style="background:linear-gradient(180deg,#FFFFFF 0%,#F3F0FB 100%)">
  <div class="container relative z-10 grid lg:grid-cols-2 gap-14 items-center py-14 lg:py-[70px]">

    <!-- Left: text content -->
    <div class="flex flex-col gap-6">
      <div class="inline-flex items-center gap-2 bg-white border border-[#E7E1F4] rounded-full px-[15px] py-[7px] w-fit shadow-[0_2px_10px_rgba(20,30,60,0.05)]">
        <span class="w-[7px] h-[7px] rounded-full bg-secondary shrink-0"></span>
        <span class="text-[12.5px] font-extrabold tracking-[1.4px] uppercase text-[#8983B8]">{content.badge}</span>
      </div>

      <h1 class="text-[38px] sm:text-[46px] lg:text-[53px] font-display font-extrabold leading-[1.05] tracking-[-1.5px] text-neutral-900 text-balance">
        {content.headlinePrefix} <span class="text-secondary">{content.headlineAccent}</span>
      </h1>

      <p class="text-lg leading-[1.7] font-medium text-neutral-600 max-w-lg">
        {content.subheadline}
      </p>

      <div class="flex flex-wrap gap-3.5">
        <a
          href={route('contact', lang)}
          class="inline-flex items-center gap-2.5 bg-secondary hover:bg-secondary-dark text-white font-bold px-[26px] py-[15px] rounded-full transition-colors text-base shadow-cta"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3.6" y="5" width="16.8" height="15.4" rx="2.4"></rect><path d="M8 3v4"></path><path d="M16 3v4"></path><path d="M3.6 9.6h16.8"></path><path d="M9 14.5l2 2 3.8-3.8"></path>
          </svg>
          {content.cta}
        </a>
        <a
          href={`tel:${CLINIC.phoneE164}`}
          class="inline-flex items-center gap-2.5 bg-white hover:bg-lavender text-primary font-bold px-6 py-[15px] rounded-full border-[1.6px] border-[#DAD4EC] transition-colors text-base"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
          </svg>
          {content.ctaPhone} {CLINIC.phone}
        </a>
      </div>

      <div class="flex flex-wrap gap-2.5" role="list" aria-label="Key benefits">
        {content.trustBadges.map((badge) => (
          <span role="listitem" class="inline-flex items-center gap-2 bg-white border border-[#E7E1F4] rounded-full px-3.5 py-2 text-[13.5px] font-semibold text-[#4A4F6B] shadow-[0_2px_8px_rgba(20,30,60,0.04)]">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F0444D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="9"></circle>
            </svg>
            {badge}
          </span>
        ))}
      </div>
    </div>

    <!-- Right: clinic photo, framed per the design's panel treatment -->
    <div class="relative hidden lg:block">
      <div class="relative rounded-[28px] overflow-hidden border border-[#E7E1F4] shadow-[0_34px_66px_rgba(47,75,199,0.16)] h-[490px]">
        <Image
          src={clinicExterior}
          alt={`${CLINIC.name} exterior — ${CLINIC.address.full}`}
          width={760}
          height={560}
          widths={[560, 760, 1140]}
          sizes="(min-width: 1024px) 46vw, 0px"
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-navy/35 via-transparent to-transparent" aria-hidden="true"></div>
      </div>

      <div class="absolute -left-5 top-10 bg-white rounded-2xl shadow-[0_16px_36px_rgba(20,30,60,0.14)] px-4 py-[13px] flex items-center gap-3">
        <span class="w-10 h-10 rounded-[11px] bg-rose-tint flex items-center justify-center shrink-0">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F0444D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3.6" y="5" width="16.8" height="15.4" rx="2.4"></rect><path d="M8 3v4"></path><path d="M16 3v4"></path><path d="M3.6 9.6h16.8"></path><path d="M9 14.5l2 2 3.8-3.8"></path>
          </svg>
        </span>
        <div class="flex flex-col">
          <span class="text-[14.5px] font-extrabold text-neutral-900">Same-day care</span>
          <span class="text-[12.5px] font-semibold text-[#8A8AAB]">Appointments &amp; walk-ins</span>
        </div>
      </div>

      <div class="absolute -right-[18px] bottom-[34px] bg-white rounded-2xl shadow-[0_16px_36px_rgba(20,30,60,0.14)] px-4 py-[13px] flex items-center gap-3">
        <span class="w-10 h-10 rounded-[11px] bg-lavender flex items-center justify-center shrink-0">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2F4BC7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle><path d="M12 7.2V12l3.4 2"></path>
          </svg>
        </span>
        <div class="flex flex-col">
          <span class="text-[14.5px] font-extrabold text-neutral-900">{openLabel}</span>
          <span class="text-[12.5px] font-semibold text-[#8A8AAB]">{openTimes}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- We proudly accept strip -->
  <div class="border-t border-[#E9E4F4] bg-white/60 relative z-10">
    <div class="container py-5 flex items-center gap-6 flex-wrap justify-center">
      <span class="text-[13px] font-extrabold tracking-[1.2px] uppercase text-[#9089B8]">We proudly accept</span>
      <div class="flex flex-wrap gap-2.5 justify-center">
        {CLINIC.insurance.slice(0, 5).map((plan) => (
          <span class="bg-white border border-[#E7E1F4] rounded-full px-4 py-2 text-sm font-bold text-primary">{plan}</span>
        ))}
      </div>
    </div>
  </div>
</section>
