---
import { Image } from 'astro:assets'
import clinicExterior from '../../assets/images/clinic-exterior.png'
import { CLINIC } from '../../data/clinic'

interface Props {
  lang?: 'en' | 'es'
}
const { lang = 'en' } = Astro.props

const content = lang === 'es'
  ? {
      badge: 'Aceptando Nuevos Pacientes',
      headline: 'Atención Médica Familiar en Oklahoma City',
      subheadline: 'Atención rápida, accesible y compasiva para toda la familia. Sin cita previa. Se habla Español.',
      cta: 'Hacer una Cita',
      ctaPhone: 'Llamar',
      trustBadges: ['Sin Cita Previa', 'Citas el Mismo Día', 'Se Habla Español', 'Aceptamos SoonerCare'],
    }
  : {
      badge: 'Now Accepting New Patients',
      headline: 'Expert Family Healthcare in Oklahoma City',
      subheadline: 'Fast, affordable, and compassionate medical care for the whole family. Walk-ins welcome — no appointment needed.',
      cta: 'Book an Appointment',
      ctaPhone: 'Call Now',
      trustBadges: ['Walk-ins Welcome', 'Same-Day Available', 'Se Habla Español', 'SoonerCare Accepted'],
    }
---

<section class="relative bg-primary overflow-hidden">
  <!-- Subtle background texture -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-white/[0.04] rounded-full"></div>
    <div class="absolute -bottom-20 left-1/3 w-72 h-72 bg-secondary/[0.08] rounded-full"></div>
  </div>

  <div class="container relative">
    <div class="grid lg:grid-cols-2 gap-0 items-stretch min-h-[520px]">

      <!-- Left: text content -->
      <div class="py-16 lg:py-20 flex flex-col justify-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-white/10 text-white/90 rounded-full px-4 py-1.5 text-sm font-medium mb-7 border border-white/15 w-fit">
          <span class="w-2 h-2 bg-secondary rounded-full animate-pulse" aria-hidden="true"></span>
          {content.badge}
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-5xl xl:text-6xl font-display font-extrabold text-white leading-[1.1] mb-5">
          {content.headline}
        </h1>

        <p class="text-lg text-white/75 leading-relaxed mb-8 max-w-lg">
          {content.subheadline}
        </p>

        <!-- Trust badges -->
        <div class="flex flex-wrap gap-2.5 mb-9" role="list" aria-label="Key benefits">
          {content.trustBadges.map((badge) => (
            <span
              role="listitem"
              class="inline-flex items-center gap-1.5 bg-white/10 text-white/90 text-sm font-medium px-4 py-2 rounded-full border border-white/15"
            >
              <svg class="w-3.5 h-3.5 text-secondary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              {badge}
            </span>
          ))}
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-dark text-white font-bold px-8 py-4 rounded-full transition-colors text-lg shadow-lg shadow-secondary/25"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            {content.cta}
          </a>
          <a
            href={`tel:${CLINIC.phoneE164}`}
            class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold px-8 py-4 rounded-full transition-colors text-lg"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            {content.ctaPhone}: {CLINIC.phone}
          </a>
        </div>
      </div>

      <!-- Right: clinic photo -->
      <div class="hidden lg:flex items-end justify-end relative">
        <!-- Subtle dark gradient on left edge so text stays readable if it overlaps -->
        <div class="absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-primary to-transparent z-10" aria-hidden="true"></div>

        <div class="relative w-full h-full">
          <Image
            src={clinicExterior}
            alt="Health Watch Medical Clinic exterior — 1924 N Portland Ave, Oklahoma City, OK"
            width={760}
            height={560}
            class="w-full h-full object-cover object-center"
            fetchpriority="high"
            loading="eager"
          />
          <!-- Gradient overlay at bottom for a clean blend into the stats bar -->
          <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-primary-dark/60 to-transparent" aria-hidden="true"></div>

          <!-- Address badge floating over the photo -->
          <div class="absolute bottom-6 right-6 bg-white/95 backdrop-blur-sm rounded-xl px-4 py-3 shadow-lg flex items-start gap-3 max-w-xs">
            <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <p class="text-neutral-900 font-semibold text-sm leading-tight">{CLINIC.address.street}</p>
              <p class="text-neutral-500 text-xs mt-0.5">{CLINIC.address.city}, {CLINIC.address.state} · {CLINIC.phone}</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Stats bar -->
<div class="bg-primary-dark border-t border-white/10">
  <div class="container py-4">
    <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      {[
        { value: 'Walk-ins', label: 'Always Welcome' },
        { value: 'Same-Day', label: 'Appointments' },
        { value: 'Bilingual', label: 'English & Spanish' },
        { value: '5+', label: 'Insurance Plans Accepted' },
      ].map((stat) => (
        <div class="py-2">
          <dt class="text-secondary font-display font-extrabold text-xl">{stat.value}</dt>
          <dd class="text-white/60 text-xs mt-0.5">{stat.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</div>
