---
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props
// Images carried over from the old clinic website's insurance gallery.
const insurers = [
  { name: 'SoonerCare / Oklahoma Health Care Authority', file: 'soonercare.jpg' },
  { name: 'Medicare', file: 'medicare.jpg' },
  { name: 'HealthChoice', file: 'healthchoice.png' },
  { name: 'UnitedHealthcare', file: 'unitedhealthcare.jpg' },
  { name: 'Blue Cross Blue Shield', file: 'bcbs.jpg' },
  { name: 'Anthem', file: 'anthem.png' },
  { name: 'TRICARE', file: 'tricare.png' },
  { name: 'Aetna', file: 'aetna.png' },
  { name: 'SoonerCare / Medicaid', file: 'medicaid.jpg' },
]
---
<div class="grid grid-cols-2 sm:grid-cols-3 gap-4 not-prose" aria-label={lang === 'es' ? 'Compañías y programas de seguros' : 'Insurance companies and programs'}>
  {insurers.map(insurer => (
    <div class="flex flex-col items-center justify-center gap-3 bg-white border border-neutral-200 rounded-2xl p-5 shadow-card">
      <img src={`/images/insurance/${insurer.file}`} alt={insurer.name} width="300" height="214" loading="lazy" decoding="async" class="w-full h-20 object-contain" />
      <p class="text-sm font-semibold text-neutral-700 text-center">{insurer.name}</p>
    </div>
  ))}
</div>
