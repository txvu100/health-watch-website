---
import { CLINIC } from '../../data/clinic'
import { route } from '../../data/routes'

interface Props {
  lang?: 'en' | 'es'
  heading?: string
  subheading?: string
}

const { lang = 'en' } = Astro.props
const heading = Astro.props.heading ?? (lang === 'es' ? 'Comience su recorrido de salud con nosotros' : 'Start your health journey with us')
const subheading = Astro.props.subheading ?? (lang === 'es'
  ? 'Estamos aquí para apoyar su salud hoy — y a largo plazo. Reserve en línea en minutos, o llame a nuestro equipo.'
  : "We're here to support your health today — and for the long term. Book online in minutes, or call our team.")
const bookLabel = lang === 'es' ? 'Hacer una cita' : 'Book an appointment'
const callLabel = lang === 'es' ? 'Llamar' : 'Call'
---

<section class="container py-0 pb-16 lg:pb-24">
  <div
    class="relative overflow-hidden rounded-[30px] px-7 sm:px-14 py-[54px] sm:py-16 flex flex-col items-center text-center gap-[22px] shadow-[0_34px_70px_rgba(47,75,199,0.3)]"
    style="background:linear-gradient(135deg,#2F4BC7 0%,#3F4BC7 55%,#4F4BB7 100%)"
  >
    <h2 class="relative text-3xl lg:text-[40px] font-display font-extrabold tracking-[-0.8px] text-white max-w-xl text-balance">{heading}</h2>
    <p class="relative text-lg leading-[1.65] font-medium text-[#D6D3EE] max-w-lg">{subheading}</p>

    <div class="relative flex flex-wrap items-center justify-center gap-3.5 mt-1">
      <a
        href={route('contact', lang)}
        class="inline-flex items-center gap-2.5 bg-secondary hover:bg-secondary-dark text-white font-bold px-7 py-[15px] rounded-full transition-colors text-base shadow-[0_12px_28px_rgba(240,68,77,0.4)]"
      >
        {bookLabel}
      </a>
      <a
        href={`tel:${CLINIC.phoneE164}`}
        class="inline-flex items-center gap-2.5 bg-white/12 hover:bg-white/20 border-[1.5px] border-white/35 text-white font-bold px-[26px] py-[15px] rounded-full transition-colors text-base"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
        </svg>
        {callLabel} {CLINIC.phone}
      </a>
    </div>
  </div>
</section>
