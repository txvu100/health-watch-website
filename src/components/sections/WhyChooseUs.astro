---
interface Feature {
  icon: string
  title: string
  description: string
}

interface Props {
  lang?: 'en' | 'es'
}
const { lang = 'en' } = Astro.props

const heading = lang === 'es' ? '¿Por Qué Elegirnos?' : 'Why Choose Health Watch?'
const subheading = lang === 'es'
  ? 'Estamos comprometidos a brindarle la atención y el cuidado que merece.'
  : 'We go beyond treating conditions — we build lasting relationships with every patient.'

const features: Feature[] = lang === 'es'
  ? [
      { icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', title: 'Sin Cita Previa', description: 'Pacientes sin cita son bienvenidos durante el horario regular. También ofrecemos citas el mismo día.' },
      { icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z', title: 'Atención Familiar Bilingüe', description: 'Personal bilingüe (inglés/español) para que cada paciente se sienta comprendido y cómodo.' },
      { icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', title: 'SoonerCare y Medicaid', description: 'Aceptamos SoonerCare, Medicaid, Medicare, seguro privado y pago en efectivo.' },
      { icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z', title: 'Precios Accesibles', description: 'Creemos que la atención de calidad debe ser accesible para todos, independientemente de su seguro médico.' },
      { icon: 'M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z', title: 'Telemedicina Disponible', description: 'Consultas seguras por video desde casa o trabajo para su comodidad.' },
      { icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z', title: 'Atención Personalizada', description: 'Un médico de cabecera que lo conoce a usted y a su historial, no solo sus síntomas.' },
    ]
  : [
      { icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', title: 'Walk-ins Always Welcome', description: "No appointment? No problem. Walk in during business hours and we'll see you with minimal wait times." },
      { icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z', title: 'Bilingual Staff — Se Habla Español', description: 'Our team is fully bilingual (English/Spanish) to ensure every patient feels comfortable and fully understood.' },
      { icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', title: 'SoonerCare & Medicaid Accepted', description: 'We accept SoonerCare, Medicaid, Medicare, private insurance, and self-pay patients. Everyone deserves quality care.' },
      { icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z', title: 'Affordable Pricing', description: 'We offer transparent, competitive pricing. Self-pay patients are welcome and we work to keep care affordable.' },
      { icon: 'M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z', title: 'Telemedicine Available', description: 'See a provider from the comfort of your home. Secure video visits available for many conditions.' },
      { icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z', title: 'Patient-Centered Care', description: 'We take time to listen, understand your history, and treat you as an individual — not just a chart.' },
    ]
---

<section class="py-16 lg:py-24">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="text-3xl lg:text-4xl font-display font-bold text-neutral-900 mb-4">{heading}</h2>
      <p class="text-neutral-600 text-lg">{subheading}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="flex gap-5">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 mt-1">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={feature.icon} />
            </svg>
          </div>
          <div>
            <h3 class="font-display font-bold text-neutral-900 mb-2">{feature.title}</h3>
            <p class="text-neutral-600 text-sm leading-relaxed">{feature.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
