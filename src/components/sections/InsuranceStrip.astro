---
import { CLINIC } from '../../data/clinic'

interface Props {
  lang?: 'en' | 'es'
}
const { lang = 'en' } = Astro.props

const heading = lang === 'es' ? 'Seguros que Aceptamos' : 'Insurance We Accept'
const subheading = lang === 'es'
  ? 'Trabajamos con la mayoría de los planes. Pacientes de pago en efectivo también bienvenidos.'
  : 'We work with most major plans. Self-pay and uninsured patients always welcome.'
---

<section class="py-12 border-y border-neutral-200">
  <div class="container">
    <div class="text-center mb-8">
      <h2 class="text-xl font-display font-bold text-neutral-900 mb-2">{heading}</h2>
      <p class="text-neutral-500 text-sm">{subheading}</p>
    </div>

    <div class="flex flex-wrap justify-center gap-3">
      {CLINIC.insurance.map((plan) => (
        <span class="inline-flex items-center gap-2 bg-neutral-50 border border-neutral-200 text-neutral-700 font-medium text-sm px-5 py-2.5 rounded-full">
          <svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          {plan}
        </span>
      ))}
    </div>

    <p class="text-center text-xs text-neutral-400 mt-6">
      Not sure if we accept your plan? <a href="/contact" class="text-primary hover:underline font-medium">Call us at {CLINIC.phone}</a> — we'll verify your benefits before your visit.
    </p>
  </div>
</section>
