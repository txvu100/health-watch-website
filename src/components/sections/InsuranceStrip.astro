---
import InsuranceLogos from './InsuranceLogos.astro'
import { CLINIC } from '../../data/clinic'

interface Props {
  lang?: 'en' | 'es'
}
const { lang = 'en' } = Astro.props

const content = lang === 'es'
  ? {
      heading: 'Seguros y Formas de Pago',
      subheading: 'Participamos con SoonerCare y Medicare, aceptamos muchos planes comerciales y pacientes de pago propio.',
      prompt: 'Llame para confirmar si participamos con su plan específico. La cobertura y la responsabilidad del paciente varían según el plan.',
      call: 'Llame al',
    }
  : {
      heading: 'Insurance & Payment',
      subheading: 'We participate with SoonerCare and Medicare, accept many commercial plans, and welcome self-pay patients.',
      prompt: 'Call to confirm whether we participate with your specific insurance plan. Coverage and patient responsibility vary by plan.',
      call: 'Call',
    }
---

<section class="py-12 border-y border-neutral-200">
  <div class="container">
    <div class="text-center mb-8">
      <h2 class="text-xl font-display font-bold text-neutral-900 mb-2">{content.heading}</h2>
      <p class="text-neutral-600 text-[16px]">{content.subheading}</p>
    </div>

    <InsuranceLogos lang={lang} />

    <p class="text-center text-sm text-neutral-600 mt-6">
      {content.prompt} <a href={`tel:${CLINIC.phoneE164}`} class="text-primary hover:underline font-medium">{content.call} {CLINIC.phone}</a>.
    </p>
  </div>
</section>
