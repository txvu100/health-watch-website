---
import { CLINIC } from '../../data/clinic'
import { useTranslations, type Lang } from '../../data/translations'

interface Props {
  lang?: Lang
  esPath?: string
  enPath?: string
}
const { lang = 'en', esPath, enPath } = Astro.props
const t = useTranslations(lang)

// Trailing slashes throughout: these are real links, and the site serves
// directory URLs, so a slash-stripped href would cost every switch a 301.
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`)
const currentPath = withSlash(Astro.url.pathname)

// Switch to the actual counterpart page rather than dumping the visitor on the
// other locale's homepage. Falls back to the locale root when no twin exists.
const enHref = lang === 'en' ? currentPath : withSlash(enPath || '/')
const esHref =
  lang === 'es' ? currentPath : esPath ? withSlash(`/es${esPath === '/' ? '' : esPath}`) : '/es/'
---

<div class="bg-navy text-white/80">
  <div class="container flex items-center justify-between gap-2 sm:gap-4 py-1.5 sm:py-2 text-[11px] sm:text-[13px] font-semibold">
    <!-- Below ~360px the label truncates to nonsense next to the phone number,
         which is the bar's more valuable item; drop the label instead. -->
    <div class="hidden min-[360px]:flex items-center gap-1.5 sm:gap-2 min-w-0">
      <svg width="14" height="14" class="shrink-0 sm:w-[15px] sm:h-[15px]" viewBox="0 0 24 24" fill="none" stroke="#F0444D" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3c2.6 2.7 2.6 15.3 0 18"></path><path d="M12 3c-2.6 2.7-2.6 15.3 0 18"></path>
      </svg>
      <span class="tracking-[0.4px] truncate">{t.utility.otherLanguage}</span>
    </div>

    <div class="flex items-center gap-2.5 sm:gap-4 shrink-0">
      <a href={`tel:${CLINIC.phoneE164}`} class="flex items-center gap-1 sm:gap-1.5 whitespace-nowrap text-white hover:opacity-80 transition-opacity">
        <svg width="13" height="13" class="shrink-0 sm:w-[14px] sm:h-[14px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
        </svg>
        {CLINIC.phoneDisplay}
      </a>
      <a href="/patient-portal/" class="hidden sm:inline hover:text-white transition-colors">{t.utility.patientPortal}</a>
      <div class="hidden sm:flex items-center gap-3">
        <a href={CLINIC.social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-white transition-colors flex">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8.5h2.5V5h-2.6C11 5 9.7 6.8 9.7 9v1.6H7.5V14h2.2v7h3.4v-7h2.4l.4-3.4h-2.8V9.2c0-.5.3-.7.9-.7z"></path></svg>
        </a>
        <a href={CLINIC.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-white transition-colors flex">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none"></circle></svg>
        </a>
        <a href={CLINIC.social.pinterest} target="_blank" rel="noopener" aria-label="Pinterest" class="hover:text-white transition-colors flex">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-4.9s-.3-.6-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.2-.9 3.5-.2 1 .5 1.9 1.6 1.9 1.9 0 3.2-2.4 3.2-5.3 0-2.2-1.5-3.8-4.1-3.8a4.7 4.7 0 0 0-4.9 4.7c0 .9.3 1.5.7 2 .2.2.2.3.1.6l-.2.9c-.1.3-.3.4-.6.2-1.2-.5-1.8-1.9-1.8-3.5 0-2.6 2.2-5.7 6.5-5.7 3.5 0 5.7 2.5 5.7 5.2 0 3.5-2 6.2-4.9 6.2-1 0-1.9-.5-2.2-1.1l-.6 2.4c-.2.8-.7 1.7-1 2.3A10 10 0 1 0 12 2z"></path></svg>
        </a>
      </div>
      <nav class="flex items-center bg-white/10 rounded-full p-[2px] sm:p-[3px] shrink-0" aria-label={lang === 'es' ? 'Cambiar idioma' : 'Change language'}>
        <a
          href={enHref}
          hreflang="en"
          lang="en"
          aria-current={lang === 'en' ? 'true' : undefined}
          class:list={['font-extrabold text-[11px] sm:text-[12px] tracking-[0.5px] px-2 sm:px-[11px] py-0.5 sm:py-1 rounded-full transition-colors', lang === 'en' ? 'bg-white text-navy' : 'text-white/70 hover:text-white']}
        >EN<span class="sr-only"> — English</span></a>
        <a
          href={esHref}
          hreflang="es"
          lang="es"
          aria-current={lang === 'es' ? 'true' : undefined}
          class:list={['font-extrabold text-[11px] sm:text-[12px] tracking-[0.5px] px-2 sm:px-[11px] py-0.5 sm:py-1 rounded-full transition-colors', lang === 'es' ? 'bg-white text-navy' : 'text-white/70 hover:text-white']}
        >ES<span class="sr-only"> — Español</span></a>
      </nav>
    </div>
  </div>
</div>
