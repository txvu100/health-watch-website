---
import MobileMenu from './MobileMenu.vue'
import { CLINIC } from '../../data/clinic'

interface Props {
  lang?: 'en' | 'es'
}
const { lang = 'en' } = Astro.props

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Insurance', href: '/insurance' },
  { label: 'Telemedicine', href: '/telemedicine' },
  { label: 'Contact', href: '/contact' },
]

const currentPath = Astro.url.pathname
---

<header class="sticky top-0 z-30 bg-primary shadow-md">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white text-primary px-4 py-2 rounded font-semibold text-sm z-50"
  >
    Skip to main content
  </a>

  <div class="container">
    <div class="flex items-center justify-between h-16 lg:h-18">

      <!-- Logo -->
      <a href={lang === 'es' ? '/es/' : '/'} class="flex items-center gap-0 shrink-0" aria-label={CLINIC.name}>
        <!-- Inline logo mark SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52" fill="none" class="w-10 h-10 shrink-0" aria-hidden="true">
          <path d="M26 2L46 9v20c0 11-20 21-20 21S6 40 6 29V9L26 2Z" fill="rgba(255,255,255,0.95)"/>
          <polyline points="9,27 14,27 16,20 19,34 22,16 25,32 27,27 43,27" stroke="#22C55E" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="ml-3 leading-tight hidden sm:block">
          <span class="block text-white font-display font-extrabold text-lg leading-none tracking-tight">HealthWatch</span>
          <span class="block text-white/70 font-medium text-[10px] tracking-[2px] uppercase">Medical Clinic</span>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'px-3.5 py-2 rounded-lg text-sm font-medium transition-colors',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-white bg-white/15'
                : 'text-white/80 hover:text-white hover:bg-white/10',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Right: bilingual badge + CTA + mobile toggle -->
      <div class="flex items-center gap-3">
        <!-- Se habla Español badge -->
        <span class="hidden md:inline-flex items-center gap-1.5 bg-white/10 text-white/90 text-xs font-semibold px-3 py-1.5 rounded-full border border-white/20">
          <span aria-hidden="true">🇲🇽</span> Se habla Español
        </span>

        <!-- Phone CTA (desktop) -->
        <a
          href={`tel:${CLINIC.phoneE164}`}
          class="hidden lg:inline-flex items-center gap-2 bg-secondary hover:bg-secondary-dark text-white font-semibold text-sm px-5 py-2.5 rounded-full transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {CLINIC.phone}
        </a>

        <!-- Mobile menu island -->
        <MobileMenu client:load />
      </div>
    </div>
  </div>
</header>
