---
import MobileMenu from './MobileMenu.vue'
import Logo from '../ui/Logo.astro'
import UtilityBar from './UtilityBar.astro'
import { CLINIC } from '../../data/clinic'
import { NAV_KEYS, route } from '../../data/routes'
import { useTranslations, type Lang } from '../../data/translations'

interface Props {
  lang?: Lang
  esPath?: string
  enPath?: string
}
const { lang = 'en', esPath, enPath } = Astro.props
const t = useTranslations(lang)

const navItems = NAV_KEYS.map((key) => ({ label: t.nav[key], href: route(key, lang) }))

// Compare like-for-like: ROUTE_PAIRS entries carry the trailing slash the site
// actually serves, so the current path has to be normalised the same way.
const currentPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`
const homeHref = route('home', lang)
---

<header class="sticky top-0 z-30">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white text-primary px-4 py-2 rounded font-semibold text-sm z-50"
  >
    {lang === 'es' ? 'Ir al contenido principal' : 'Skip to main content'}
  </a>

  <UtilityBar lang={lang} esPath={esPath} enPath={enPath} />

  <div class="bg-white shadow-[0_1px_0_#EDECF4,0_6px_20px_rgba(20,30,60,0.04)]">
    <div class="container">
      <div class="flex items-center gap-4 h-16 lg:h-[70px]">

        <a href={homeHref} class="shrink-0" aria-label={CLINIC.name}>
          <Logo size={40} withWordmark={false} />
        </a>

        <!-- Desktop nav -->
        <nav class="hidden xl:flex items-center justify-end gap-5 flex-1" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
          {navItems.map((item) => {
            const active =
              currentPath === item.href || (item.href !== homeHref && currentPath.startsWith(item.href))
            return (
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex flex-col items-center gap-1.5 text-[15px] font-semibold transition-colors',
                  active ? 'text-neutral-900' : 'text-neutral-600 hover:text-primary',
                ]}
              >
                {item.label}
                <span class:list={['h-[2.5px] w-full rounded-full', active ? 'bg-secondary' : 'bg-transparent']}></span>
              </a>
            )
          })}
        </nav>

        <div class="ml-auto flex items-center gap-2 xl:ml-0 xl:gap-3">
          <a
            href={CLINIC.patientPortalUrl}
            class="hidden xl:inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-5 py-3 text-base font-bold text-white shadow-card-hover transition-colors hover:bg-primary-dark shrink-0"
          >
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <circle cx="12" cy="8" r="3.5"></circle>
              <path d="M5 20a7 7 0 0 1 14 0"></path>
            </svg>
            {t.nav.patientPortalSignIn}
          </a>
          <a
            href={route('contact', lang)}
            class="hidden xl:inline-flex min-h-12 items-center gap-2 bg-secondary hover:bg-secondary-dark text-white font-bold text-base px-[22px] py-[11px] rounded-full shadow-cta transition-colors shrink-0"
          >
            {t.nav.bookAppointment}
          </a>

          <a
            href={CLINIC.patientPortalUrl}
            aria-label={t.nav.patientPortalSignIn}
            class="inline-flex h-10 items-center justify-center gap-1.5 rounded-full bg-primary px-2.5 text-xs font-bold text-white shadow-card transition-colors hover:bg-primary-dark xl:hidden"
          >
            <svg width="17" height="17" class="shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <circle cx="12" cy="8" r="3.5"></circle>
              <path d="M5 20a7 7 0 0 1 14 0"></path>
            </svg>
            <span>Portal</span>
          </a>
          <a
            href={route('contact', lang)}
            aria-label={t.nav.bookAppointment}
            class="inline-flex h-10 items-center justify-center gap-1.5 rounded-full bg-secondary px-2.5 text-xs font-bold text-white shadow-cta transition-colors hover:bg-secondary-dark xl:hidden"
          >
            <svg width="17" height="17" class="shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M16 3v4M8 3v4M3 10h18"></path>
            </svg>
            <span>{lang === 'es' ? 'Cita' : 'Book'}</span>
          </a>

          <MobileMenu client:load lang={lang} />
        </div>
      </div>

    </div>
  </div>
</header>
