---
import { CLINIC } from '../../data/clinic'
import { SERVICES, serviceHref, serviceTitle } from '../../data/services'
import { NAV_KEYS, route } from '../../data/routes'
import { useTranslations, type Lang } from '../../data/translations'
import Logo from '../ui/Logo.astro'

interface Props {
  lang?: Lang
}
const { lang = 'en' } = Astro.props
const t = useTranslations(lang)

const serviceLinks = SERVICES.map((s) => ({
  label: serviceTitle(s, lang),
  href: serviceHref(s, lang),
}))

const exploreLinks = NAV_KEYS.map((key) => ({ label: t.nav[key], href: route(key, lang) }))

// Derived from CLINIC.hours so the footer summary can never drift from the
// hours table or the openingHoursSpecification JSON-LD.
const dayName = (h: (typeof CLINIC.hours)[number]) => (lang === 'es' ? h.dayEs : h.day)
const abbr = (h: (typeof CLINIC.hours)[number]) => dayName(h).slice(0, 3)
const staffed = CLINIC.hours.filter((h) => h.opens24)
const weekdayLine = `${abbr(staffed[0])}\u2013${abbr(staffed[staffed.length - 1])} ${staffed[0].open} \u2013 ${staffed[0].close}`
const closedDays = CLINIC.hours
  .filter((h) => !h.opens24)
  .map((h) => `${abbr(h)} ${(lang === 'es' ? h.noteEs : h.note).toLowerCase()}`)
  .join(' \u00b7 ')

const year = new Date().getFullYear()
---

<footer class="bg-navy text-white/70">
  <div class="container py-14 lg:py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href={route('home', lang)} class="inline-flex mb-5" aria-label={CLINIC.name}>
          <Logo size={42} dark />
        </a>
        <p class="text-white/60 text-sm leading-relaxed mb-5 max-w-[280px]">
          {t.footer.description}
        </p>
        <div class="inline-flex items-center gap-2 bg-white/8 border border-white/12 rounded-full px-3.5 py-1.5 mb-5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#F0444D" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3c2.6 2.7 2.6 15.3 0 18"></path><path d="M12 3c-2.6 2.7-2.6 15.3 0 18"></path>
          </svg>
          <span class="text-white font-bold text-xs tracking-[0.4px]">Se habla español</span>
        </div>
        <div class="flex gap-3">
          <a href={CLINIC.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-9 h-9 rounded-full bg-white/8 hover:bg-secondary hover:text-white flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
          </a>
          <a href={CLINIC.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-9 h-9 rounded-full bg-white/8 hover:bg-secondary hover:text-white flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href={CLINIC.social.pinterest} target="_blank" rel="noopener noreferrer" aria-label="Pinterest" class="w-9 h-9 rounded-full bg-white/8 hover:bg-secondary hover:text-white flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Explore column -->
      <div>
        <h2 class="text-white/50 font-display font-extrabold text-[13px] uppercase tracking-[1.4px] mb-4">{t.footer.explore}</h2>
        <ul class="space-y-3">
          {exploreLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/70 hover:text-white text-[15px] transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services column -->
      <div>
        <h2 class="text-white/50 font-display font-extrabold text-[13px] uppercase tracking-[1.4px] mb-4">{t.footer.services}</h2>
        <ul class="space-y-3">
          {serviceLinks.slice(0, 7).map((link) => (
            <li>
              <a href={link.href} class="text-white/70 hover:text-white text-[14.5px] transition-colors">{link.label}</a>
            </li>
          ))}
          <li>
            <a href={route('services', lang)} class="text-secondary hover:text-secondary-dark text-[14.5px] font-bold transition-colors">{t.services.allServices} →</a>
          </li>
        </ul>
      </div>

      <!-- Visit us column -->
      <div class="flex flex-col gap-4">
        <h2 class="text-white/50 font-display font-extrabold text-[13px] uppercase tracking-[1.4px]">{t.footer.visitUs}</h2>
        <div class="flex items-start gap-3">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F0444D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span class="text-[14.5px] leading-relaxed text-white/70">{CLINIC.address.street}<br />{CLINIC.address.city}, {CLINIC.address.state}</span>
        </div>
        <div class="flex items-center gap-3">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F0444D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
          </svg>
          <a href={`tel:${CLINIC.phoneE164}`} class="text-white font-bold text-[15px] hover:text-secondary transition-colors">{CLINIC.phoneDisplay}</a>
        </div>
        <div class="flex items-start gap-3">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F0444D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
          </svg>
          <span class="text-[14px] leading-[1.7] text-white/70">{weekdayLine}<br />{closedDays}</span>
        </div>
        <a
          href={route('contact', lang)}
          class="mt-1 inline-block bg-secondary hover:bg-secondary-dark text-white text-sm font-bold px-5 py-[11px] rounded-full text-center transition-colors"
        >
          {t.nav.bookAppointment}
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/12">
    <div class="container py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-[13px] text-white/45">
      <p>© {year} {CLINIC.name}. {t.footer.rights}</p>
      <div class="flex items-center gap-[18px]">
        <a href={route('privacy', lang)} class="hover:text-white/80 transition-colors">{t.footer.privacy}</a>
        <a href="/patient-portal/" class="hover:text-white/80 transition-colors">{t.nav.patientPortal}</a>
        <a href={route('contact', lang)} class="hover:text-white/80 transition-colors">{t.nav.contact}</a>
      </div>
    </div>
  </div>
</footer>
