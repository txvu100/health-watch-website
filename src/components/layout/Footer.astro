---
import { CLINIC } from '../../data/clinic'
import { SERVICES } from '../../data/services'

interface Props {
  lang?: 'en' | 'es'
}
const { lang = 'en' } = Astro.props

const serviceLinks = SERVICES.map((s) => ({
  label: s.title,
  href: `/services/${s.slug}`,
}))
---

<footer class="bg-navy text-white">
  <!-- Main footer grid -->
  <div class="container py-14 lg:py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-4" aria-label={CLINIC.name}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52" fill="none" class="w-10 h-10 shrink-0" aria-hidden="true">
            <path d="M26 2L46 9v20c0 11-20 21-20 21S6 40 6 29V9L26 2Z" fill="rgba(255,255,255,0.9)"/>
            <polyline points="9,27 14,27 16,20 19,34 22,16 25,32 27,27 43,27" stroke="#22C55E" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div class="leading-tight">
            <span class="block text-white font-display font-extrabold text-lg tracking-tight">HealthWatch</span>
            <span class="block text-white/60 text-[10px] tracking-[2px] uppercase font-medium">Medical Clinic</span>
          </div>
        </a>
        <p class="text-white/60 text-sm leading-relaxed mb-5">
          Your Health, Our Priority. Expert family healthcare serving Oklahoma City and surrounding communities.
        </p>
        <!-- Social icons -->
        <div class="flex gap-3">
          <a href={CLINIC.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
          </a>
          <a href={CLINIC.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href={CLINIC.social.pinterest} target="_blank" rel="noopener noreferrer" aria-label="Pinterest" class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services column -->
      <div>
        <h3 class="text-white font-display font-bold text-sm uppercase tracking-wider mb-5">Our Services</h3>
        <ul class="space-y-2">
          {serviceLinks.slice(0, 7).map((link) => (
            <li>
              <a href={link.href} class="text-white/60 hover:text-white text-sm transition-colors">{link.label}</a>
            </li>
          ))}
          <li>
            <a href="/services" class="text-secondary hover:text-secondary-dark text-sm font-medium transition-colors">View all services →</a>
          </li>
        </ul>
      </div>

      <!-- Quick links column -->
      <div>
        <h3 class="text-white font-display font-bold text-sm uppercase tracking-wider mb-5">Quick Links</h3>
        <ul class="space-y-2">
          {[
            { label: 'Home', href: '/' },
            { label: 'About Us', href: '/about' },
            { label: 'Insurance & Payment', href: '/insurance' },
            { label: 'Patient Portal', href: '/patient-portal' },
            { label: 'Telemedicine', href: '/telemedicine' },
            { label: 'Contact', href: '/contact' },
            { label: 'Español', href: '/es/' },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-white/60 hover:text-white text-sm transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact / Hours column -->
      <div>
        <h3 class="text-white font-display font-bold text-sm uppercase tracking-wider mb-5">Contact & Hours</h3>
        <address class="not-italic space-y-3 text-sm text-white/70">
          <div class="flex gap-3">
            <svg class="w-4 h-4 text-secondary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{CLINIC.address.street}<br />{CLINIC.address.city}, {CLINIC.address.state} {CLINIC.address.zip}</span>
          </div>
          <div class="flex gap-3">
            <svg class="w-4 h-4 text-secondary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`tel:${CLINIC.phoneE164}`} class="hover:text-white transition-colors">{CLINIC.phone}</a>
          </div>
          <div class="flex gap-3">
            <svg class="w-4 h-4 text-secondary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${CLINIC.email}`} class="hover:text-white transition-colors break-all">{CLINIC.email}</a>
          </div>
        </address>
        <div class="mt-5 text-sm text-white/70 space-y-1">
          <p class="font-semibold text-white/90">Hours</p>
          <p>Mon–Fri: 9:00 AM – 5:00 PM</p>
          <p>Saturday: By Appointment</p>
          <p>Sunday: Closed</p>
        </div>
        <div class="mt-4">
          <span class="inline-flex items-center gap-1.5 bg-secondary/20 text-secondary text-xs font-semibold px-3 py-1.5 rounded-full border border-secondary/30">
            🇲🇽 Se Habla Español
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="container py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/40">
      <p>© 2025 Health Watch Medical Clinic. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="/privacy-policy" class="hover:text-white/70 transition-colors">Privacy Policy</a>
        <a href="/contact" class="hover:text-white/70 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
