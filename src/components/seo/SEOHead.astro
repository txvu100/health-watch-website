---
import { CLINIC } from '../../data/clinic'
import JsonLd from './JsonLd.astro'

interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  ogImageAlt?: string
  lang?: 'en' | 'es'
  /** Extra JSON-LD schemas to inject alongside the base MedicalClinic schema */
  schemas?: Record<string, unknown>[]
  /** Path of the paired /es/ page, relative to /es (e.g. '/contacto') */
  esPath?: string
  /** Path of the paired English page (e.g. '/contact') */
  enPath?: string
  noindex?: boolean
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = `${CLINIC.siteUrl}/og-default.jpg`,
  ogImageAlt = `${CLINIC.name} — ${CLINIC.address.full}`,
  lang = 'en',
  schemas = [],
  esPath,
  enPath,
  noindex = false,
} = Astro.props

// Pages already naming the brand are left alone. The suffix deliberately omits
// "Oklahoma City" — nearly every page title already carries the city, and
// repeating it pushed titles past 90 characters, well beyond SERP truncation.
const pageTitle = title.includes('Health Watch') ? title : `${title} | ${CLINIC.name}`

// Canonical carries the trailing slash that directory output actually serves,
// so canonical, sitemap <loc>, and internal links all name the same URL and no
// page canonicalises to a URL that would redirect.
const withSlash = (url: string) => (url.endsWith('/') ? url : `${url}/`)
const canonicalClean = withSlash(canonical)

// hreflang: every page in a cluster must declare the complete set *including
// itself*, or Google treats the annotation as unconfirmed and ignores it.
const esUrl =
  lang === 'es'
    ? canonicalClean
    : esPath
      ? withSlash(`${CLINIC.siteUrl}/es${esPath === '/' ? '' : esPath}`)
      : undefined
const enUrl =
  lang === 'en'
    ? canonicalClean
    : enPath
      ? withSlash(`${CLINIC.siteUrl}${enPath === '/' ? '' : enPath}`)
      : undefined

// A cluster of one carries no information — only annotate real pairs.
const alternates =
  enUrl && esUrl
    ? [
        { hreflang: 'en', href: enUrl },
        { hreflang: 'es', href: esUrl },
        { hreflang: 'x-default', href: enUrl },
      ]
    : []

// Base MedicalClinic JSON-LD — injected on every page
const clinicSchema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalClinic', 'LocalBusiness'],
  '@id': `${CLINIC.siteUrl}/#clinic`,
  name: CLINIC.name,
  url: CLINIC.siteUrl,
  telephone: CLINIC.phoneE164,
  email: CLINIC.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CLINIC.address.street,
    addressLocality: CLINIC.address.city,
    addressRegion: CLINIC.address.state,
    postalCode: CLINIC.address.zip,
    addressCountry: CLINIC.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: CLINIC.geo.lat,
    longitude: CLINIC.geo.lng,
  },
  openingHoursSpecification: CLINIC.hoursSchema,
  availableLanguage: CLINIC.languages,
  paymentAccepted: CLINIC.insurance.join(', '),
  priceRange: '$',
  sameAs: [CLINIC.social.facebook, CLINIC.social.instagram],
  image: `${CLINIC.siteUrl}/og-default.jpg`,
  hasMap: CLINIC.mapsDirectionsUrl,
}

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${CLINIC.siteUrl}/#website`,
  url: CLINIC.siteUrl,
  name: CLINIC.name,
  inLanguage: lang === 'es' ? 'es-US' : 'en-US',
  publisher: { '@id': `${CLINIC.siteUrl}/#clinic` },
}

const allSchemas = [clinicSchema, websiteSchema, ...schemas]
---

<!-- Primary meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalClean} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow" />}

<!-- Geo / Local SEO -->
<meta name="geo.region" content="US-OK" />
<meta name="geo.placename" content="Oklahoma City, OK" />
<meta name="geo.position" content={`${CLINIC.geo.lat};${CLINIC.geo.lng}`} />
<meta name="ICBM" content={`${CLINIC.geo.lat}, ${CLINIC.geo.lng}`} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={CLINIC.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:url" content={canonicalClean} />
<meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
{esUrl && enUrl && (
  <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_US'} />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- hreflang -->
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}

<!-- Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#1B1B3A" />

<!-- Font preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

<!-- JSON-LD structured data -->
{allSchemas.map((schema) => <JsonLd schema={schema} />)}
