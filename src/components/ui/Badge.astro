---
interface Props {
  variant?: 'primary' | 'secondary' | 'neutral' | 'spanish'
  class?: string
}
const { variant = 'primary', class: className = '' } = Astro.props

const variants = {
  primary: 'bg-primary/10 text-primary border-primary/20',
  secondary: 'bg-secondary/10 text-secondary-dark border-secondary/20',
  neutral: 'bg-neutral-100 text-neutral-700 border-neutral-200',
  spanish: 'bg-amber-50 text-amber-800 border-amber-200',
}
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full border',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
