---
interface Props {
  title: string
  icon?: string
}
const { title, icon = 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' } = Astro.props
---

<div class="flex gap-[18px] bg-white border border-neutral-200 border-l-4 border-l-primary rounded-2xl px-[26px] py-6 shadow-card">
  <span class="w-11 h-11 rounded-xl bg-lavender flex items-center justify-center shrink-0">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2F4BC7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d={icon} />
    </svg>
  </span>
  <div class="flex flex-col gap-1">
    <h3 class="text-[17px] font-display font-extrabold text-neutral-900">{title}</h3>
    <p class="text-sm text-neutral-600 leading-[1.6]"><slot /></p>
  </div>
</div>
