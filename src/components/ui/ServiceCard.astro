---
import type { Service } from '../../data/services'

interface Props {
  service: Service
  lang?: 'en' | 'es'
}

const { service, lang = 'en' } = Astro.props
const title = lang === 'es' ? service.titleEs : service.title
const description = lang === 'es' ? service.shortDescriptionEs : service.shortDescription
---

<article class="group bg-white rounded-2xl border border-neutral-200 hover:border-primary/30 hover:shadow-lg transition-all duration-200 overflow-hidden flex flex-col">
  <!-- Teal top accent bar -->
  <div class="h-1 bg-primary group-hover:bg-secondary transition-colors" aria-hidden="true"></div>

  <div class="p-6 flex flex-col flex-1">
    <!-- Icon -->
    <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-5 group-hover:bg-primary/20 transition-colors">
      <svg
        class="w-6 h-6 text-primary"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
      </svg>
    </div>

    <h3 class="text-lg font-display font-bold text-neutral-900 mb-2 leading-snug">{title}</h3>
    <p class="text-neutral-600 text-sm leading-relaxed flex-1">{description}</p>

    <a
      href={`/services/${service.slug}`}
      class="mt-5 inline-flex items-center gap-1.5 text-primary font-semibold text-sm hover:text-primary-dark transition-colors group/link"
      aria-label={`Learn more about ${title}`}
    >
      Learn more
      <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
