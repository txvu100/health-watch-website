---
interface BreadcrumbItem {
  label: string
  href?: string
}

interface Props {
  items: BreadcrumbItem[]
  dark?: boolean
}

const { items, dark = false } = Astro.props
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && (
          <svg
            class:list={['w-3 h-3', dark ? 'text-white/40' : 'text-neutral-400']}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {item.href ? (
          <a
            href={item.href}
            class:list={[
              'transition-colors',
              dark
                ? 'text-white/70 hover:text-white'
                : 'text-neutral-500 hover:text-primary',
            ]}
          >
            {item.label}
          </a>
        ) : (
          <span
            class:list={[dark ? 'text-white/90 font-medium' : 'text-neutral-900 font-medium']}
            aria-current="page"
          >
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
