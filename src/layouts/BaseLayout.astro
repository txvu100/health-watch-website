---
import SEOHead from '../components/seo/SEOHead.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  lang?: 'en' | 'es'
  schemas?: Record<string, unknown>[]
  esPath?: string
  enPath?: string
  noindex?: boolean
}

const { lang = 'en', ...seoProps } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <SEOHead lang={lang} {...seoProps} />
  </head>
  <body class="bg-white text-neutral-900 antialiased">
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
