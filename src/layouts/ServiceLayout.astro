---
import BaseLayout from './BaseLayout.astro'
import CallToAction from '../components/sections/CallToAction.astro'
import ServiceDetailBlock from '../components/sections/ServiceDetailBlock.astro'
import FAQ from '../components/sections/FAQ.astro'
import ServiceCard from '../components/ui/ServiceCard.astro'
import { CLINIC } from '../data/clinic'
import { getRelatedServices, serviceHref, serviceTitle, type Service } from '../data/services'
import { route } from '../data/routes'
import { useTranslations, type Lang } from '../data/translations'

interface Props {
  service: Service
  lang?: Lang
}

const { service, lang = 'en' } = Astro.props
const t = useTranslations(lang)

const title = serviceTitle(service, lang)
const summary = lang === 'es' ? service.shortDescriptionEs : service.shortDescription
const metaDescription = lang === 'es' ? service.metaDescriptionEs : service.metaDescription
const faqs = lang === 'es' ? service.faqsEs : service.faqs

const selfUrl = `${CLINIC.siteUrl}${serviceHref(service, lang)}`
// A standalone landing page may own this keyword (see /telemedicine); when it
// does, point at the SAME-language landing page instead of competing with it.
const canonical = service.canonicalOverride?.[lang] ?? selfUrl
// hreflang belongs on the canonical URL. Annotating a page that points its
// canonical elsewhere just gives Google a contradictory cluster.
const isCanonicalSelf = canonical === selfUrl

const relatedServices = getRelatedServices(service.relatedSlugs)

const servicesUrl = `${CLINIC.siteUrl}${route('services', lang)}`
const homeUrl = lang === 'es' ? `${CLINIC.siteUrl}/es/` : CLINIC.siteUrl

// MedicalService JSON-LD
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalService',
  '@id': `${selfUrl}#service`,
  name: title,
  description: summary,
  inLanguage: lang === 'es' ? 'es-US' : 'en-US',
  provider: { '@id': `${CLINIC.siteUrl}/#clinic` },
  areaServed: {
    '@type': 'City',
    name: 'Oklahoma City',
    sameAs: 'https://en.wikipedia.org/wiki/Oklahoma_City',
  },
}

// FAQPage JSON-LD — skipped where another page already publishes the same set
const faqSchema =
  service.suppressFaqSchema || faqs.length === 0
    ? null
    : {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.q,
          acceptedAnswer: { '@type': 'Answer', text: faq.a },
        })),
      }

// BreadcrumbList JSON-LD
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.breadcrumb.home, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: t.breadcrumb.services, item: servicesUrl },
    { '@type': 'ListItem', position: 3, name: title, item: selfUrl },
  ],
}

const schemas = [serviceSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]
---

<BaseLayout
  title={lang === 'es' ? `${title} en Oklahoma City | Health Watch` : `${title} in Oklahoma City | Health Watch`}
  description={metaDescription}
  canonical={canonical}
  lang={lang}
  esPath={isCanonicalSelf && lang === 'en' ? `/servicios/${service.slugEs}` : undefined}
  enPath={isCanonicalSelf && lang === 'es' ? `/services/${service.slug}` : undefined}
  schemas={schemas}
>
  <!-- Hero: alternating detail block -->
  <section class="relative overflow-hidden" style="background:linear-gradient(180deg,#FFFFFF 0%,#F3F0FB 100%)">
    <div class="container py-14 lg:py-20">
      <nav aria-label={t.breadcrumb.label} class="text-[13px] font-bold text-[#9089B8] mb-6">
        <a href={route('home', lang)} class="hover:text-primary">{t.breadcrumb.home}</a>
        <span aria-hidden="true"> / </span>
        <a href={route('services', lang)} class="hover:text-primary">{t.breadcrumb.services}</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{title}</span>
      </nav>
      <ServiceDetailBlock service={service} lang={lang} />
    </div>
  </section>

  <!-- Main content -->
  <section class="py-14 lg:py-20">
    <div class="container">
      <div class="max-w-3xl">
        <!-- Service description (passed as slot) -->
        <div class="prose prose-lg max-w-none text-neutral-600 leading-relaxed space-y-4">
          <slot />
        </div>

        <!-- Why Choose Us callout -->
        <div class="mt-10 rounded-2xl bg-lavender p-6 lg:p-8">
          <h2 class="text-xl font-display font-extrabold text-neutral-900 mb-3">{t.why.heading}</h2>
          <ul class="space-y-2 text-neutral-600">
            {t.why.points.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-secondary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {faqs.length > 0 && (
    <section class="py-14 lg:py-20 border-t border-neutral-200">
      <div class="container max-w-3xl">
        <h2 class="text-2xl lg:text-3xl font-display font-extrabold tracking-[-0.5px] text-neutral-900 mb-8">
          {t.faq.heading}
        </h2>
        <FAQ faqs={faqs} />
      </div>
    </section>
  )}

  <!-- Related services -->
  {relatedServices.length > 0 && (
    <section class="py-14 lg:py-20">
      <div class="container">
        <h2 class="text-2xl font-display font-extrabold text-neutral-900 mb-8">{t.services.related}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedServices.map((s) => <ServiceCard service={s} lang={lang} />)}
        </div>
      </div>
    </section>
  )}

  <CallToAction lang={lang} />
</BaseLayout>
