---
import BaseLayout from './BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import CallToAction from '../components/sections/CallToAction.astro'
import FAQ from '../components/sections/FAQ.astro'
import ServiceCard from '../components/ui/ServiceCard.astro'
import { CLINIC } from '../data/clinic'
import { getRelatedServices, type Service } from '../data/services'

interface Props {
  service: Service
  lang?: 'en' | 'es'
}

const { service, lang = 'en' } = Astro.props

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: service.title },
]

const relatedServices = getRelatedServices(service.relatedSlugs)

// MedicalService JSON-LD
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalService',
  '@id': `${CLINIC.siteUrl}/services/${service.slug}#service`,
  name: service.title,
  description: service.shortDescription,
  provider: { '@id': `${CLINIC.siteUrl}/#clinic` },
  areaServed: {
    '@type': 'City',
    name: 'Oklahoma City',
    sameAs: 'https://en.wikipedia.org/wiki/Oklahoma_City',
  },
}

// FAQPage JSON-LD
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
}

// BreadcrumbList JSON-LD
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: CLINIC.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${CLINIC.siteUrl}/services` },
    { '@type': 'ListItem', position: 3, name: service.title, item: `${CLINIC.siteUrl}/services/${service.slug}` },
  ],
}
---

<BaseLayout
  title={`${service.title} in Oklahoma City, OK`}
  description={service.metaDescription}
  canonical={`${CLINIC.siteUrl}/services/${service.slug}`}
  lang={lang}
  schemas={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Hero -->
  <section class="bg-primary py-14 lg:py-20">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} dark />
      <div class="mt-6 max-w-2xl">
        <h1 class="text-3xl lg:text-5xl font-display font-bold text-white leading-tight mb-4">
          {service.title}
          <span class="block text-secondary text-xl lg:text-2xl font-semibold mt-2">
            in Oklahoma City, OK
          </span>
        </h1>
        <p class="text-white/80 text-lg leading-relaxed">{service.shortDescription}</p>
        <div class="flex flex-wrap gap-4 mt-8">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-dark text-white font-semibold px-7 py-3 rounded-full transition-colors"
          >
            Book Appointment
          </a>
          <a
            href={`tel:${CLINIC.phoneE164}`}
            class="inline-flex items-center gap-2 border-2 border-white/60 hover:border-white text-white font-semibold px-7 py-3 rounded-full transition-colors"
          >
            Call {CLINIC.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-14 lg:py-20">
    <div class="container">
      <div class="max-w-3xl">
        <!-- Service description (passed as slot) -->
        <div class="prose prose-lg max-w-none text-neutral-600 leading-relaxed space-y-4">
          <slot />
        </div>

        <!-- Why Choose Us callout -->
        <div class="mt-10 rounded-2xl bg-neutral-100 p-6 lg:p-8 border border-neutral-200">
          <h2 class="text-xl font-display font-bold text-neutral-900 mb-3">Why Choose Health Watch?</h2>
          <ul class="space-y-2 text-neutral-600">
            {[
              'Walk-ins welcome — no appointment needed for most visits',
              'Same-day appointments frequently available',
              'Bilingual staff — se habla Español',
              'SoonerCare, Medicaid, Medicare & private insurance accepted',
              'Locally owned and operated in Oklahoma City since opening',
            ].map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-secondary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {service.faqs.length > 0 && (
    <section class="py-14 lg:py-20 bg-neutral-50 border-t border-neutral-200">
      <div class="container max-w-3xl">
        <h2 class="text-2xl lg:text-3xl font-display font-bold text-neutral-900 mb-8">
          Frequently Asked Questions
        </h2>
        <FAQ faqs={service.faqs} />
      </div>
    </section>
  )}

  <!-- Related services -->
  {relatedServices.length > 0 && (
    <section class="py-14 lg:py-20">
      <div class="container">
        <h2 class="text-2xl font-display font-bold text-neutral-900 mb-8">Related Services</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedServices.map((s) => <ServiceCard service={s} />)}
        </div>
      </div>
    </section>
  )}

  <CallToAction />
</BaseLayout>
