---
import BaseLayout from '../layouts/BaseLayout.astro'
import CallToAction from '../components/sections/CallToAction.astro'
import { CLINIC } from '../data/clinic'

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${CLINIC.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Insurance', item: `${CLINIC.siteUrl}/insurance/` },
  ],
}
---

<BaseLayout
  title="Insurance & Payment | Health Watch Medical Clinic"
  description="Insurance and self-pay information for Health Watch Medical Clinic in Oklahoma City. Call (405) 949-1552 to confirm plan participation and coverage."
  canonical={`${CLINIC.siteUrl}/insurance/`}
  esPath="/seguros"
  schemas={[breadcrumbSchema]}
>
  <section class="relative overflow-hidden" style="background:linear-gradient(180deg,#FFFFFF 0%,#F3F0FB 100%)">
    <div class="container max-w-2xl py-14 lg:py-20">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="w-[7px] h-[7px] rounded-full bg-secondary" aria-hidden="true"></span>
        <span class="text-[13px] font-extrabold tracking-[1.8px] uppercase text-[#8983B8]">Insurance & payment</span>
      </div>
      <h1 class="text-[32px] lg:text-[42px] font-display font-extrabold tracking-[-1px] text-neutral-900 mb-3">Insurance & Payment</h1>
      <p class="text-lg leading-[1.7] font-medium text-neutral-600">We participate with SoonerCare and Medicare, accept many commercial insurance plans, and welcome self-pay patients.</p>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="container max-w-3xl">
      <div class="prose prose-neutral max-w-none space-y-5 text-neutral-600 leading-relaxed text-[16px]">
        <h2 class="text-2xl font-display font-extrabold text-neutral-900">Confirm your coverage before your visit</h2>
        <p>Call us to confirm whether we participate with your specific insurance plan. Coverage and patient responsibility vary by plan. Your insurer can also help confirm your benefits.</p>

        <div class="grid sm:grid-cols-3 gap-4 not-prose">
          {[
            ['SoonerCare', 'Please call to confirm eligibility and covered services.'],
            ['Medicare', 'Please call to confirm participation and covered services.'],
            ['Commercial plans & self-pay', 'Many commercial plans and self-pay options may be available.'],
          ].map(([title, text]) => (
            <div class="bg-white border border-neutral-200 rounded-xl p-5 shadow-card">
              <h3 class="font-display font-extrabold text-neutral-900 mb-2">{title}</h3>
              <p class="text-sm leading-relaxed text-neutral-600">{text}</p>
            </div>
          ))}
        </div>

        <h2 class="text-xl font-display font-extrabold text-neutral-900">Self-pay patients</h2>
        <p>Self-pay patients are welcome. Call the clinic to ask about current self-pay pricing before your visit.</p>

        <div class="bg-lavender rounded-2xl p-6 not-prose">
          <p class="font-semibold text-neutral-900 mb-2">Questions about your plan?</p>
          <p class="text-neutral-600 text-sm mb-4">We can help you understand whether the clinic participates with your plan, but coverage and payment are determined by your insurer and plan.</p>
          <a href={`tel:${CLINIC.phoneE164}`} class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white font-semibold px-6 py-3 rounded-full transition-colors text-sm">Call {CLINIC.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>
