---
import SpanishLayout from '../../layouts/SpanishLayout.astro'
import CallToAction from '../../components/sections/CallToAction.astro'
import FAQ from '../../components/sections/FAQ.astro'
import PhotoPlaceholderPanel from '../../components/ui/PhotoPlaceholderPanel.astro'
import { CLINIC } from '../../data/clinic'
import { getService } from '../../data/services'

const service = getService('telemedicine')!

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${CLINIC.siteUrl}/es/` },
    { '@type': 'ListItem', position: 2, name: 'Telemedicina', item: `${CLINIC.siteUrl}/es/telemedicina/` },
  ],
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqsEs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
}

const steps = [
  { title: 'Agende su consulta', text: 'Llámenos o use el portal del paciente para programar su cita por video — con frecuencia el mismo día.' },
  { title: 'Reciba su enlace seguro', text: 'Le enviaremos un enlace privado antes de la hora de su cita.' },
  { title: 'Hable con su proveedor', text: 'Conéctese desde su teléfono, tableta o computadora — sin aplicaciones ni cuentas.' },
]

const useCases = [
  'Resfriado, gripe y enfermedades leves',
  'Renovación de recetas',
  'Consultas de seguimiento',
  'Consultas de salud mental',
  'Revisión de resultados de laboratorio',
  'Preguntas médicas generales',
]
---

<SpanishLayout
  title="Telemedicina en Oklahoma City | Health Watch Medical Clinic"
  description="Consulte a un médico por video desde casa, en español. Telemedicina segura en Oklahoma City, OK. Aceptamos SoonerCare y Medicaid. Llame al (405) 949-1552."
  canonical={`${CLINIC.siteUrl}/es/telemedicina/`}
  enPath="/telemedicine"
  schemas={[breadcrumbSchema, faqSchema]}
>
  <section class="relative overflow-hidden" style="background:linear-gradient(180deg,#FFFFFF 0%,#F3F0FB 100%)">
    <div class="container grid lg:grid-cols-2 gap-14 items-center py-14 lg:py-20">
      <div class="flex flex-col gap-6">
        <nav aria-label="Ruta de navegación" class="text-[13px] font-bold text-[#9089B8]">
          <a href="/es/" class="hover:text-primary">Inicio</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">Telemedicina</span>
        </nav>
        <div class="inline-flex items-center gap-2">
          <span class="w-[7px] h-[7px] rounded-full bg-secondary"></span>
          <span class="text-[13px] font-extrabold tracking-[1.8px] uppercase text-[#8983B8]">Telemedicina</span>
        </div>
        <h1 class="text-[32px] sm:text-[38px] lg:text-[49px] font-display font-extrabold leading-[1.08] tracking-[-1.4px] text-neutral-900">
          Atención de calidad, desde la comodidad de su casa
        </h1>
        <p class="text-lg leading-[1.7] font-medium text-neutral-600">{service.shortDescriptionEs}</p>
        <div class="flex flex-wrap gap-3.5">
          <a href="/es/contacto/" class="inline-flex items-center gap-2.5 bg-secondary hover:bg-secondary-dark text-white font-bold px-[26px] py-[15px] rounded-full transition-colors shadow-cta">Agendar consulta por video</a>
          <a href={`tel:${CLINIC.phoneE164}`} class="inline-flex items-center gap-2.5 bg-white hover:bg-lavender text-primary font-bold px-6 py-[15px] rounded-full border-[1.6px] border-[#DAD4EC] transition-colors">Llamar {CLINIC.phone}</a>
        </div>
      </div>
      <PhotoPlaceholderPanel minHeight="min-h-[320px] lg:min-h-[380px]" iconSize={30} icon={service.icon} label="Consulta por video segura" />
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="container max-w-4xl">
      <h2 class="text-2xl lg:text-3xl font-display font-extrabold tracking-[-0.5px] text-neutral-900 mb-10">Cómo Funciona</h2>
      <ol class="grid sm:grid-cols-3 gap-6">
        {steps.map((step, i) => (
          <li class="bg-white border border-neutral-200 rounded-[20px] p-6 shadow-card">
            <span class="w-9 h-9 rounded-full bg-lavender text-primary font-extrabold flex items-center justify-center mb-3">{i + 1}</span>
            <h3 class="font-display font-extrabold text-neutral-900 mb-2 text-[17px]">{step.title}</h3>
            <p class="text-neutral-600 text-sm leading-[1.6]">{step.text}</p>
          </li>
        ))}
      </ol>

      <h2 class="text-2xl lg:text-3xl font-display font-extrabold tracking-[-0.5px] text-neutral-900 mt-16 mb-6">¿Qué se Puede Atender por Video?</h2>
      <ul class="grid sm:grid-cols-2 gap-3">
        {useCases.map((item) => (
          <li class="flex items-center gap-3 bg-white border border-neutral-200 rounded-xl px-5 py-4 shadow-card">
            <svg class="w-5 h-5 text-secondary shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span class="text-[15px] text-neutral-700">{item}</span>
          </li>
        ))}
      </ul>

      <div class="mt-10 rounded-2xl bg-lavender p-6 lg:p-8">
        <p class="font-bold text-primary mb-2">Se habla español</p>
        <p class="text-[#4A4F6B] text-sm leading-relaxed">Su consulta por video puede ser completamente en español. No necesita un intérprete ni saber inglés para recibir atención.</p>
      </div>
    </div>
  </section>

  <section class="py-14 lg:py-20 bg-neutral-50 border-t border-neutral-200">
    <div class="container max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-display font-extrabold tracking-[-0.5px] text-neutral-900 mb-8">Preguntas Frecuentes</h2>
      <FAQ faqs={service.faqsEs} />
    </div>
  </section>

  <CallToAction lang="es" />
</SpanishLayout>
