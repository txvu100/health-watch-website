---
import SpanishLayout from '../../layouts/SpanishLayout.astro'
import ContactForm from '../../components/forms/ContactForm.vue'
import HoursTable from '../../components/ui/HoursTable.astro'
import { CLINIC } from '../../data/clinic'
---

<SpanishLayout
  title="Contacto | Health Watch Medical Clinic Oklahoma City"
  description="Contacte a Health Watch Medical Clinic en Oklahoma City. Llame al (405) 949-1552 o envíenos un mensaje. Ubicados en 1924 N Portland Ave. Se habla Español."
  canonical={`${CLINIC.siteUrl}/es/contacto`}
  enPath="/contact"
>
  <section class="bg-primary py-14">
    <div class="container max-w-2xl">
      <h1 class="text-3xl lg:text-4xl font-display font-extrabold text-white mb-3">Contáctenos</h1>
      <p class="text-white/80 text-lg">Comuníquese por teléfono, correo electrónico o el formulario a continuación. Se aceptan pacientes sin cita previa.</p>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="container">
      <div class="grid lg:grid-cols-5 gap-12">
        <div class="lg:col-span-3">
          <h2 class="text-2xl font-display font-bold text-neutral-900 mb-6">Envíenos un Mensaje</h2>
          <p class="text-neutral-600 mb-8 text-sm">Respondemos todos los mensajes dentro de 1 día hábil. Para urgencias, llámenos al <a href={`tel:${CLINIC.phoneE164}`} class="text-primary font-semibold hover:underline">{CLINIC.phone}</a>.</p>
          <ContactForm client:visible />
        </div>

        <aside class="lg:col-span-2 space-y-6">
          <div class="bg-neutral-50 rounded-2xl border border-neutral-200 p-6">
            <h2 class="font-display font-bold text-neutral-900 mb-4">Información de la Clínica</h2>
            <address class="not-italic space-y-4 text-sm text-neutral-600">
              <div class="flex gap-3">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <div>
                  <p class="font-semibold text-neutral-700">Dirección</p>
                  <p class="mt-0.5">{CLINIC.address.street}<br />{CLINIC.address.city}, {CLINIC.address.state} {CLINIC.address.zip}</p>
                </div>
              </div>
              <div class="flex gap-3">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <div>
                  <p class="font-semibold text-neutral-700">Teléfono</p>
                  <a href={`tel:${CLINIC.phoneE164}`} class="text-primary hover:underline">{CLINIC.phone}</a>
                </div>
              </div>
            </address>
          </div>

          <div class="bg-neutral-50 rounded-2xl border border-neutral-200 p-6">
            <h2 class="font-display font-bold text-neutral-900 mb-4">Horario de Atención</h2>
            <HoursTable />
          </div>

          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 flex gap-3">
            <span class="text-2xl" aria-hidden="true">🇲🇽</span>
            <div>
              <p class="font-semibold text-amber-900 text-sm">¡Se Habla Español!</p>
              <p class="text-amber-800 text-sm mt-0.5">Todo nuestro equipo es bilingüe. Puede comunicarse en el idioma de su preferencia.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</SpanishLayout>
