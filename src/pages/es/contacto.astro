---
import SpanishLayout from '../../layouts/SpanishLayout.astro'
import HoursTable from '../../components/ui/HoursTable.astro'
import { CLINIC } from '../../data/clinic'

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${CLINIC.siteUrl}/es/` },
    { '@type': 'ListItem', position: 2, name: 'Contacto', item: `${CLINIC.siteUrl}/es/contacto/` },
  ],
}
---

<SpanishLayout
  title="Contacto | Health Watch Medical Clinic"
  description="Contacte a Health Watch Medical Clinic en Oklahoma City. Llame al (405) 949-1552 o escríbanos. Estamos en 1924 N Portland Ave. Se habla español."
  canonical={`${CLINIC.siteUrl}/es/contacto/`}
  enPath="/contact"
  schemas={[breadcrumbSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:linear-gradient(180deg,#FFFFFF 0%,#F3F0FB 100%)">
    <div class="container max-w-2xl py-14 lg:py-20 text-center mx-auto">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="w-[7px] h-[7px] rounded-full bg-secondary"></span>
        <span class="text-[13px] font-extrabold tracking-[1.8px] uppercase text-[#8983B8]">Contáctenos</span>
      </div>
      <h1 class="text-[32px] lg:text-[42px] font-display font-extrabold tracking-[-1px] text-neutral-900 mb-3">Nos encantaría saber de usted</h1>
      <p class="text-lg leading-[1.7] font-medium text-neutral-600">Llámenos, escríbanos o simplemente venga. La mayoría de las visitas no requieren cita.</p>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="container">
      <div class="grid lg:grid-cols-5 gap-12 items-start">
        <div class="lg:col-span-3 bg-white border border-neutral-200 rounded-[24px] p-[38px] shadow-[0_10px_30px_rgba(20,30,60,0.06)]">
          <h2 class="text-[23px] font-display font-extrabold text-neutral-900 mb-2">Agende su visita</h2>
          <p class="text-neutral-600 mb-7 text-sm leading-relaxed">
            La forma más rápida de comunicarse con nosotros es por teléfono. Nuestra recepción puede
            agendarle una cita, verificar su seguro y responder sus preguntas en el momento — en español.
          </p>

          <a
            href={`tel:${CLINIC.phoneE164}`}
            class="flex items-center gap-4 bg-secondary hover:bg-secondary-dark text-white rounded-[18px] px-6 py-5 shadow-cta transition-colors"
          >
            <span class="w-[46px] h-[46px] rounded-[13px] bg-white/15 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>
              </svg>
            </span>
            <span class="flex flex-col">
              <span class="text-[12px] font-extrabold tracking-[1px] uppercase text-white/75">Llame a la clínica</span>
              <span class="text-[19px] sm:text-[22px] font-extrabold leading-tight whitespace-nowrap">{CLINIC.phone}</span>
            </span>
          </a>

          <a
            href={`mailto:${CLINIC.email}`}
            class="mt-3 flex items-center gap-4 bg-white border-[1.6px] border-[#DAD4EC] hover:bg-lavender rounded-[18px] px-6 py-[18px] transition-colors"
          >
            <span class="w-[46px] h-[46px] rounded-[13px] bg-lavender flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="#2F4BC7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
              </svg>
            </span>
            <span class="flex flex-col min-w-0">
              <span class="text-[12px] font-extrabold tracking-[1px] uppercase text-[#9089B8]">Escríbanos</span>
              <span class="text-[15px] font-bold text-neutral-900 break-all">{CLINIC.email}</span>
            </span>
          </a>

          <div class="mt-7 pt-7 border-t border-neutral-200">
            <h3 class="font-display font-extrabold text-neutral-900 mb-3 text-[17px]">¿Viene sin cita?</h3>
            <ul class="space-y-2.5">
              {[
                'La mayoría de las visitas no requieren cita — venga durante nuestro horario.',
                'Traiga una identificación con foto y su tarjeta de seguro, si tiene.',
                'Aceptamos SoonerCare, Medicaid, Medicare, seguros privados y pago en efectivo.',
                'No se requiere número de seguro social ni estatus migratorio para ser atendido.',
              ].map((item) => (
                <li class="flex items-start gap-3 text-[15px] text-neutral-600 leading-[1.6]">
                  <svg class="w-5 h-5 text-secondary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <p class="mt-5 text-sm text-neutral-500 leading-relaxed">
              Por favor no envíe información médica, números de seguro ni otros datos sensibles por
              correo electrónico. Llámenos y con gusto lo atendemos de forma segura por teléfono.
            </p>
          </div>
        </div>

        <aside class="lg:col-span-2 flex flex-col gap-4">
          <div class="flex items-start gap-4 bg-white border border-neutral-200 rounded-[18px] px-6 py-[22px] shadow-card">
            <span class="w-[50px] h-[50px] rounded-[14px] bg-lavender flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="#2F4BC7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <div>
              <p class="text-xs font-extrabold tracking-[0.8px] uppercase text-[#9089B8] mb-1">Visítenos</p>
              <p class="text-[15.5px] font-bold text-neutral-900 leading-[1.5]">{CLINIC.address.street}<br />{CLINIC.address.city}, {CLINIC.address.state} {CLINIC.address.zip}</p>
              <a href={CLINIC.mapsDirectionsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-secondary font-bold text-[13.5px] mt-1.5 hover:text-secondary-dark">
                Cómo llegar →
              </a>
            </div>
          </div>

          <div class="bg-white border border-neutral-200 rounded-[18px] px-6 py-[22px] shadow-card">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-[38px] h-[38px] rounded-[11px] bg-lavender flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#2F4BC7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </span>
              <h2 class="font-display font-extrabold text-neutral-900">Horario de atención</h2>
            </div>
            <HoursTable lang="es" />
          </div>

          <a href="/patient-portal/" class="flex items-center gap-4 bg-primary hover:bg-primary-dark rounded-[18px] px-6 py-[22px] shadow-[0_12px_28px_rgba(47,75,199,0.22)] transition-colors">
            <span class="w-[42px] h-[42px] rounded-xl bg-white/14 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </span>
            <div>
              <p class="text-white font-extrabold text-base">Portal del paciente</p>
              <p class="text-[13.5px] font-semibold text-white/70">Gestione su atención en línea</p>
            </div>
          </a>

          <div class="bg-lavender rounded-2xl p-5 flex gap-3">
            <span class="w-[38px] h-[38px] rounded-[11px] bg-white flex items-center justify-center shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2F4BC7" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3c2.6 2.7 2.6 15.3 0 18"></path><path d="M12 3c-2.6 2.7-2.6 15.3 0 18"></path>
              </svg>
            </span>
            <div>
              <p class="font-bold text-primary text-sm">¡Se Habla Español!</p>
              <p class="text-[#4A4F6B] text-sm mt-0.5">Todo nuestro equipo es bilingüe. Puede comunicarse en el idioma de su preferencia.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</SpanishLayout>
