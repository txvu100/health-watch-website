---
import SpanishLayout from '../../layouts/SpanishLayout.astro'
import ServicesGrid from '../../components/sections/ServicesGrid.astro'
import CallToAction from '../../components/sections/CallToAction.astro'
import { CLINIC } from '../../data/clinic'
---

<SpanishLayout
  title="Servicios Médicos | Health Watch Medical Clinic Oklahoma City"
  description="Servicios de medicina familiar en Oklahoma City: presión arterial, diabetes, salud de la mujer, examen médico de inmigración, salud mental, salud infantil, físicos y telemedicina. (405) 949-1552."
  canonical={`${CLINIC.siteUrl}/es/servicios`}
  enPath="/services"
>
  <section class="bg-primary py-14">
    <div class="container max-w-2xl">
      <h1 class="text-3xl lg:text-5xl font-display font-extrabold text-white leading-tight mb-4">Nuestros Servicios</h1>
      <p class="text-white/80 text-lg">Medicina familiar integral para cada etapa de la vida — todo en un solo lugar en Oklahoma City.</p>
    </div>
  </section>

  <ServicesGrid lang="es" showViewAll={false} />
  <CallToAction lang="es" />
</SpanishLayout>
