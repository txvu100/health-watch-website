---
import ServiceLayout from '../../../layouts/ServiceLayout.astro'
import { SERVICES, type Service } from '../../../data/services'

export async function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slugEs },
    props: { service },
  }))
}

interface Props {
  service: Service
}

const { service } = Astro.props
const serviceItems = service.serviceItemsEs ?? []
const serviceItemsHeading = service.serviceItemsHeadingEs
---

<ServiceLayout service={service} lang="es">
  {service.descriptionEs.split('\n\n').filter(Boolean).map((para) => (
    <p set:html={para.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
  ))}
  {serviceItems.length > 0 && (
    <>
      {serviceItemsHeading && <h2 class="text-xl font-display font-extrabold text-neutral-900 pt-2">{serviceItemsHeading}</h2>}
      <ul class="list-disc space-y-2 pl-6 marker:text-secondary">
        {serviceItems.map((item) => <li>{item}</li>)}
      </ul>
    </>
  )}
</ServiceLayout>
