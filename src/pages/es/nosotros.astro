---
import SpanishLayout from '../../layouts/SpanishLayout.astro'
import CallToAction from '../../components/sections/CallToAction.astro'
import MissionBand from '../../components/sections/MissionBand.astro'
import TeamCard from '../../components/ui/TeamCard.astro'
import { CLINIC } from '../../data/clinic'

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${CLINIC.siteUrl}/es/` },
    { '@type': 'ListItem', position: 2, name: 'Nosotros', item: `${CLINIC.siteUrl}/es/nosotros/` },
  ],
}

const badges = [
  'Independiente y de propiedad local',
  'Personal bilingüe',
  'Aceptamos la mayoría de los seguros',
  'Tiempos de espera mínimos',
]

const features = [
  { title: 'Proveedores con experiencia', text: 'Un equipo que le atiende con respeto y con verdadera urgencia.' },
  { title: 'Personal bilingüe', text: 'Atención clara y cómoda, en inglés y en español.' },
  { title: 'Precios claros y accesibles', text: 'Costos justos y comunicación transparente en cada visita.' },
  { title: 'Citas rápidas', text: 'Opciones el mismo día y tiempos de espera mínimos.' },
  { title: 'Ambiente familiar y limpio', text: 'Un espacio acogedor para todas las edades.' },
  { title: 'Atendemos sin cita previa', text: '¿No tiene cita? No hay problema — visítenos durante nuestro horario.' },
]

const team = [
  { name: 'Helen Mboh', role: 'Proveedora · Medicina Familiar', blurb: 'Dirige la atención al paciente con enfoque en la prevención, el manejo de enfermedades crónicas y consultas sin prisas.' },
  { name: 'Asistentes Médicos', role: 'Apoyo clínico', blurb: 'Acompañan cada visita con signos vitales, pruebas y cuidado directo para que su proveedor se concentre en usted.' },
  { name: 'Coordinadores de Pacientes', role: 'Recepción', blurb: 'Se encargan de las citas, las preguntas de seguro y el registro — normalmente la primera cara amable que verá.' },
]
---

<SpanishLayout
  title="Sobre Nosotros | Health Watch Medical Clinic"
  description="Clínica de medicina familiar independiente en Oklahoma City, OK. Personal bilingüe, atendemos sin cita previa y aceptamos SoonerCare y Medicaid."
  canonical={`${CLINIC.siteUrl}/es/nosotros/`}
  enPath="/about"
  schemas={[breadcrumbSchema]}
>
  <section class="relative overflow-hidden" style="background:linear-gradient(180deg,#FFFFFF 0%,#F3F0FB 100%)">
    <div class="container max-w-3xl py-14 lg:py-20 flex flex-col gap-5">
      <nav aria-label="Ruta de navegación" class="text-[13px] font-bold text-[#9089B8]">
        <a href="/es/" class="hover:text-primary">Inicio</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">Nosotros</span>
      </nav>
      <div class="inline-flex items-center gap-2">
        <span class="w-[7px] h-[7px] rounded-full bg-secondary"></span>
        <span class="text-[13px] font-extrabold tracking-[1.8px] uppercase text-[#8983B8]">Sobre Health Watch</span>
      </div>
      <h1 class="text-[32px] sm:text-[38px] lg:text-[46px] font-display font-extrabold leading-[1.08] tracking-[-1.2px] text-neutral-900">
        Atención local, con la dedicación que usted merece
      </h1>
      <p class="text-lg leading-[1.7] font-medium text-neutral-600 max-w-lg">
        Somos una clínica médica independiente de propiedad local en Oklahoma City. Ayudamos a nuestros pacientes a mantenerse sanos y a controlar enfermedades crónicas con un trato cercano y personal.
      </p>
      <ul class="flex flex-wrap gap-2.5 mt-1">
        {badges.map((badge) => (
          <li class="inline-flex items-center gap-2 bg-white border border-[#E4DFF3] rounded-full px-4 py-2 text-[13.5px] font-semibold text-[#3A3A5C]">
            <span class="w-[6px] h-[6px] rounded-full bg-secondary" aria-hidden="true"></span>
            {badge}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <MissionBand lang="es" />

  <section class="py-16 lg:py-24">
    <div class="container">
      <h2 class="text-2xl lg:text-3xl font-display font-extrabold tracking-[-0.5px] text-neutral-900 mb-3">Por Qué las Familias nos Eligen</h2>
      <p class="text-neutral-600 mb-10 max-w-2xl">Nos comprometemos a brindarle la atención y el cuidado que merece, en su propio idioma.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {features.map((f) => (
          <div class="bg-white border border-neutral-200 rounded-[20px] p-6 shadow-card">
            <h3 class="font-display font-extrabold text-neutral-900 mb-2 text-[17px]">{f.title}</h3>
            <p class="text-neutral-600 text-sm leading-[1.6]">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-neutral-50 border-t border-neutral-200">
    <div class="container">
      <h2 class="text-2xl lg:text-3xl font-display font-extrabold tracking-[-0.5px] text-neutral-900 mb-10">Conozca a su Equipo de Atención</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {team.map((member) => (
          <TeamCard name={member.name} role={member.role} blurb={member.blurb} />
        ))}
      </div>
    </div>
  </section>

  <CallToAction lang="es" />
</SpanishLayout>
