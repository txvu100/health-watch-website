---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactForm from '../components/forms/ContactForm.vue'
import HoursTable from '../components/ui/HoursTable.astro'
import { CLINIC } from '../data/clinic'

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: CLINIC.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${CLINIC.siteUrl}/contact` },
  ],
}
---

<BaseLayout
  title="Contact & Directions | Health Watch Medical Clinic Oklahoma City"
  description="Contact Health Watch Medical Clinic in Oklahoma City, OK. Call (405) 949-1552, email us, or use our online form. Located at 1924 N Portland Ave. Walk-ins welcome Mon–Fri 9 AM–5 PM."
  canonical={`${CLINIC.siteUrl}/contact`}
  schemas={[breadcrumbSchema]}
>
  <!-- Hero -->
  <section class="bg-primary py-14">
    <div class="container max-w-2xl">
      <h1 class="text-3xl lg:text-4xl font-display font-extrabold text-white mb-3">Contact Us</h1>
      <p class="text-white/80 text-lg">Reach out by phone, email, or the form below. Walk-ins always welcome.</p>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="container">
      <div class="grid lg:grid-cols-5 gap-12">

        <!-- Contact form (3/5) -->
        <div class="lg:col-span-3">
          <h2 class="text-2xl font-display font-bold text-neutral-900 mb-6">Send Us a Message</h2>
          <p class="text-neutral-600 mb-8 text-sm">
            We respond to all messages within 1 business day. For urgent concerns, please call us directly at
            <a href={`tel:${CLINIC.phoneE164}`} class="text-primary font-semibold hover:underline">{CLINIC.phone}</a>.
          </p>
          <ContactForm client:visible />
        </div>

        <!-- Info sidebar (2/5) -->
        <aside class="lg:col-span-2 space-y-6">
          <!-- Address + phone -->
          <div class="bg-neutral-50 rounded-2xl border border-neutral-200 p-6">
            <h2 class="font-display font-bold text-neutral-900 mb-4">Clinic Information</h2>
            <address class="not-italic space-y-4 text-sm">
              <div class="flex gap-3">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <div>
                  <p class="font-semibold text-neutral-700">Address</p>
                  <p class="text-neutral-600 mt-0.5">{CLINIC.address.street}<br />{CLINIC.address.city}, {CLINIC.address.state} {CLINIC.address.zip}</p>
                  <a href={CLINIC.mapsDirectionsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-primary font-medium text-xs mt-1.5 hover:underline">
                    Get directions →
                  </a>
                </div>
              </div>
              <div class="flex gap-3">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <div>
                  <p class="font-semibold text-neutral-700">Phone</p>
                  <a href={`tel:${CLINIC.phoneE164}`} class="text-primary hover:underline">{CLINIC.phone}</a>
                </div>
              </div>
              <div class="flex gap-3">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <div>
                  <p class="font-semibold text-neutral-700">Email</p>
                  <a href={`mailto:${CLINIC.email}`} class="text-primary hover:underline break-all text-xs">{CLINIC.email}</a>
                </div>
              </div>
            </address>
          </div>

          <!-- Hours -->
          <div class="bg-neutral-50 rounded-2xl border border-neutral-200 p-6">
            <h2 class="font-display font-bold text-neutral-900 mb-4">Hours of Operation</h2>
            <HoursTable />
            <p class="text-xs text-neutral-500 mt-4">Walk-ins welcome during all regular business hours.</p>
          </div>

          <!-- Language note -->
          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 flex gap-3">
            <span class="text-2xl" aria-hidden="true">🇲🇽</span>
            <div>
              <p class="font-semibold text-amber-900 text-sm">Se habla Español</p>
              <p class="text-amber-800 text-sm mt-0.5">Our entire team is bilingual. You are welcome to communicate in your preferred language.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="border-t border-neutral-200">
    <iframe
      title="Health Watch Medical Clinic location map"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3255.0!2d-97.581!3d35.490!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s1924+N+Portland+Ave%2C+Oklahoma+City%2C+OK+73107!5e0!3m2!1sen!2sus!4v1"
      width="100%"
      height="400"
      style="border:0; display:block;"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </section>
</BaseLayout>
