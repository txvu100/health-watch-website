---
import BaseLayout from '../layouts/BaseLayout.astro'
import { CLINIC } from '../data/clinic'

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${CLINIC.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Nondiscrimination', item: `${CLINIC.siteUrl}/nondiscrimination/` },
  ],
}
---

<BaseLayout
  title="Nondiscrimination | Health Watch Medical Clinic"
  description="Nondiscrimination statement for Health Watch Medical Clinic."
  canonical={`${CLINIC.siteUrl}/nondiscrimination/`}
  esPath="/no-discriminacion"
  schemas={[breadcrumbSchema]}
>
  <section class="relative overflow-hidden" style="background:linear-gradient(180deg,#FFFFFF 0%,#F3F0FB 100%)">
    <div class="container max-w-2xl py-14 lg:py-20">
      <nav aria-label="Breadcrumb" class="mb-5 text-[13px] font-bold text-[#9089B8]">
        <a href="/" class="hover:text-primary">Home</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">Nondiscrimination</span>
      </nav>
      <h1 class="mb-3 text-[32px] font-display font-extrabold tracking-[-1px] text-neutral-900 lg:text-[42px]">Nondiscrimination Statement</h1>
      <p class="text-lg font-medium leading-[1.7] text-neutral-600">Respectful care for every patient</p>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="container max-w-3xl">
      <div class="prose prose-neutral max-w-none space-y-4 text-neutral-600 leading-relaxed">
        <!-- Clinic/legal review is required before a production release. -->

        <h2 class="text-xl font-display font-extrabold text-neutral-900">Our commitment</h2>
        <p>Health Watch Medical Clinic does not exclude people from participation in its services or treat them differently because of race, color, national origin, age, disability, or sex, including pregnancy, sexual orientation, gender identity, and sex characteristics.</p>

        <h2 class="text-xl font-display font-extrabold text-neutral-900">Communication support</h2>
        <p>We want patients to be able to communicate effectively with our clinic. Please contact us before or during your visit to discuss language assistance or reasonable communication accommodations.</p>

        <h2 class="text-xl font-display font-extrabold text-neutral-900">Questions or concerns</h2>
        <p>For questions about this statement or to request the clinic's current formal notice, call <a href={`tel:${CLINIC.phoneE164}`} class="font-medium text-primary hover:underline">{CLINIC.phone}</a>, email <a href={`mailto:${CLINIC.email}`} class="font-medium text-primary hover:underline">{CLINIC.email}</a>, or visit us at {CLINIC.address.full}.</p>
      </div>
    </div>
  </section>
</BaseLayout>
