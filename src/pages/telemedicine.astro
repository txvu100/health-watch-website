---
import BaseLayout from '../layouts/BaseLayout.astro'
import CallToAction from '../components/sections/CallToAction.astro'
import FAQ from '../components/sections/FAQ.astro'
import { CLINIC } from '../data/clinic'
import { getService } from '../data/services'

const service = getService('telemedicine')!

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
}
---

<BaseLayout
  title="Telemedicine Oklahoma City | Health Watch Medical Clinic"
  description="See a doctor online from home. Health Watch Medical Clinic offers HIPAA-compliant telemedicine video visits in Oklahoma City, OK. SoonerCare & Medicaid accepted. (405) 949-1552."
  canonical={`${CLINIC.siteUrl}/telemedicine`}
  schemas={[faqSchema]}
>
  <!-- Hero -->
  <section class="bg-primary py-14 lg:py-20">
    <div class="container max-w-2xl">
      <h1 class="text-3xl lg:text-5xl font-display font-extrabold text-white leading-tight mb-4">
        Telemedicine in Oklahoma City
      </h1>
      <p class="text-white/80 text-lg mb-8">See a provider from your home or office. Secure video visits for follow-ups, prescription refills, chronic disease management, and more.</p>
      <div class="flex flex-wrap gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-dark text-white font-bold px-8 py-4 rounded-full transition-colors">Schedule Video Visit</a>
        <a href={`tel:${CLINIC.phoneE164}`} class="inline-flex items-center gap-2 border-2 border-white/60 hover:border-white text-white font-semibold px-8 py-4 rounded-full transition-colors">Call {CLINIC.phone}</a>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 lg:py-24">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div class="space-y-5 text-neutral-600 leading-relaxed">
          <h2 class="text-2xl font-display font-bold text-neutral-900">Healthcare From Your Home</h2>
          <p>Health Watch Medical Clinic offers secure, HIPAA-compliant telemedicine visits so you can see a provider from the comfort of your home or office. Our telemedicine service is available to patients in Oklahoma City and throughout Oklahoma.</p>
          <p>Video visits are conducted through a secure online platform. You will receive a link before your appointment — all you need is a smartphone, tablet, or computer with a camera and microphone.</p>
          <p>To schedule a telemedicine appointment, call us at <a href={`tel:${CLINIC.phoneE164}`} class="text-primary font-medium hover:underline">{CLINIC.phone}</a> or use the patient portal. Same-day availability is often possible.</p>

          <h3 class="text-lg font-display font-bold text-neutral-900 pt-4">What You Need</h3>
          <ul class="space-y-2">
            {[
              'Smartphone, tablet, or computer with a camera and microphone',
              'Stable internet connection',
              'Quiet, private space',
              'Your pharmacy name and address for any prescriptions',
            ].map((item) => (
              <li class="flex gap-3 items-start">
                <svg class="w-5 h-5 text-secondary mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-sm">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-xl font-display font-bold text-neutral-900 mb-5">Conditions Treated via Telemedicine</h3>
          <div class="grid grid-cols-2 gap-3">
            {[
              'Chronic disease follow-up',
              'Prescription refills',
              'Diabetes management',
              'Blood pressure management',
              'Mental health check-ins',
              'Cold, flu & minor illness',
              'Rash evaluation',
              'Lab result reviews',
              'UTI symptoms',
              'Medication questions',
            ].map((item) => (
              <div class="flex items-center gap-2 bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-sm text-neutral-700 font-medium">
                <svg class="w-4 h-4 text-secondary shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {item}
              </div>
            ))}
          </div>
          <p class="text-xs text-neutral-500 mt-4">Conditions requiring a physical exam or in-person procedures require an office visit.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-14 bg-neutral-50 border-t border-neutral-200">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-display font-bold text-neutral-900 mb-8">Telemedicine FAQs</h2>
      <FAQ faqs={service.faqs} />
    </div>
  </section>

  <CallToAction />
</BaseLayout>
