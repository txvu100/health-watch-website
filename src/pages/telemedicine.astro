---
import BaseLayout from '../layouts/BaseLayout.astro'
import CallToAction from '../components/sections/CallToAction.astro'
import FAQ from '../components/sections/FAQ.astro'
import PhotoPlaceholderPanel from '../components/ui/PhotoPlaceholderPanel.astro'
import NoticeCard from '../components/ui/NoticeCard.astro'
import { CLINIC } from '../data/clinic'
import { getService } from '../data/services'

const service = getService('telemedicine')!

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${CLINIC.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Telemedicine', item: `${CLINIC.siteUrl}/telemedicine/` },
  ],
}

const steps = [
  { title: 'Book your visit', text: 'Call us or use the patient portal to schedule a video appointment — often same-day.' },
  { title: 'Get your secure link', text: "You'll receive a private link before your appointment time." },
  { title: 'Meet your provider', text: 'Join from your phone, tablet, or computer — no app or account required.' },
]

const useCases = [
  'Cold, flu & minor illness',
  'Prescription refills',
  'Follow-up visits',
  'Mental health check-ins',
  'Reviewing lab results',
  'General medical questions',
]

const needs = [
  { text: 'A smartphone, tablet, or computer with a camera' },
  { text: 'A stable internet connection' },
  { text: 'A quiet, private space' },
  { text: 'Your patient portal login' },
]
---

<BaseLayout
  title="Telemedicine Oklahoma City | Health Watch Medical Clinic"
  description="See a doctor online from home. HIPAA-compliant video visits in Oklahoma City, OK. SoonerCare & Medicaid accepted. Call (405) 949-1552."
  canonical={`${CLINIC.siteUrl}/telemedicine/`}
  esPath="/telemedicina"
  schemas={[faqSchema, breadcrumbSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:linear-gradient(180deg,#FFFFFF 0%,#F3F0FB 100%)">
    <div class="container grid lg:grid-cols-2 gap-14 items-center py-14 lg:py-20">
      <div class="flex flex-col gap-6">
        <div class="inline-flex items-center gap-2">
          <span class="w-[7px] h-[7px] rounded-full bg-secondary"></span>
          <span class="text-[13px] font-extrabold tracking-[1.8px] uppercase text-[#8983B8]">Telemedicine</span>
        </div>
        <h1 class="text-[32px] sm:text-[38px] lg:text-[49px] font-display font-extrabold leading-[1.08] tracking-[-1.4px] text-neutral-900">
          Quality care, from the comfort of home
        </h1>
        <p class="text-lg leading-[1.7] font-medium text-neutral-600 max-w-lg">
          See a provider from your home or office. Secure video visits for follow-ups, prescription refills, chronic disease management, and more.
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a href="/contact/" class="inline-flex items-center gap-2.5 bg-secondary hover:bg-secondary-dark text-white font-bold px-[26px] py-[15px] rounded-full transition-colors shadow-cta">Book a video visit</a>
          <a href={`tel:${CLINIC.phoneE164}`} class="inline-flex items-center gap-2.5 bg-white hover:bg-lavender text-primary font-bold px-6 py-[15px] rounded-full border-[1.6px] border-[#DAD4EC] transition-colors">Call {CLINIC.phone}</a>
        </div>
      </div>
      <PhotoPlaceholderPanel dark label="Secure video visit" minHeight="min-h-[380px] lg:min-h-[430px]" iconSize={38} icon="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </div>
  </section>

  <!-- How telemedicine works -->
  <section class="py-16 lg:py-24">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl lg:text-4xl font-display font-extrabold tracking-[-0.7px] text-neutral-900">How telemedicine works</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {steps.map((step, i) => (
          <div class="bg-white border border-neutral-200 rounded-[22px] p-[30px_26px] shadow-card">
            <div class="flex items-start justify-between mb-4">
              <span class="w-[54px] h-[54px] rounded-[15px] bg-lavender flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={['M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z', 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z', 'M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z'][i]} />
                </svg>
              </span>
              <span class="text-[34px] font-display font-extrabold text-lavender leading-none">{`0${i + 1}`}</span>
            </div>
            <h3 class="text-[19px] font-display font-extrabold text-neutral-900 mb-1.5">{step.title}</h3>
            <p class="text-sm leading-[1.65] text-neutral-600">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What you can use it for -->
  <section class="py-16 lg:py-24 bg-lavender">
    <div class="container grid lg:grid-cols-[1.2fr_0.8fr] gap-12 items-start">
      <div>
        <h2 class="text-3xl lg:text-4xl font-display font-extrabold tracking-[-0.7px] text-neutral-900 mb-8">What you can use it for</h2>
        <div class="grid grid-cols-2 gap-3.5">
          {useCases.map((item) => (
            <div class="flex items-center gap-3 bg-white border border-[#E4DEF2] rounded-[14px] px-4 py-[15px]">
              <span class="w-10 h-10 rounded-[11px] bg-lavender flex items-center justify-center shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2F4BC7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="9"></circle>
                </svg>
              </span>
              <span class="text-[15px] font-bold text-neutral-900">{item}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-white border border-[#E4DEF2] rounded-[22px] p-[30px_28px]">
        <h3 class="text-lg font-display font-extrabold text-neutral-900 mb-5">What you'll need</h3>
        <div class="flex flex-col gap-4">
          {needs.map((need) => (
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-[11px] bg-rose-tint flex items-center justify-center shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F0444D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="9"></circle>
                </svg>
              </span>
              <span class="text-[15px] font-semibold text-[#3A3A5C]">{need.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Notice -->
  <section class="py-14">
    <div class="container max-w-3xl">
      <NoticeCard title="Some visits are better in person">
        Conditions requiring a physical exam or in-person procedures — like immigration exams, most well-child checkups, and new-patient visits — still require an office visit. We'll let you know if that's the case for you.
      </NoticeCard>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-14 border-t border-neutral-200">
    <div class="container max-w-3xl">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-display font-extrabold tracking-[-0.7px] text-neutral-900 mb-3">Telemedicine FAQs</h2>
      </div>
      <FAQ faqs={service.faqs} />
    </div>
  </section>

  <CallToAction heading="Ready for a video visit?" />
</BaseLayout>
