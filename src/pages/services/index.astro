---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ServicesGrid from '../../components/sections/ServicesGrid.astro'
import CallToAction from '../../components/sections/CallToAction.astro'
import { CLINIC } from '../../data/clinic'

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: CLINIC.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${CLINIC.siteUrl}/services` },
  ],
}
---

<BaseLayout
  title="Medical Services | Health Watch Medical Clinic Oklahoma City"
  description="Comprehensive family medicine services in Oklahoma City: blood pressure, diabetes, women's health, immigration exams, mental health, child health, physicals & telemedicine. (405) 949-1552."
  canonical={`${CLINIC.siteUrl}/services`}
  schemas={[breadcrumbSchema]}
>
  <section class="bg-primary py-14">
    <div class="container max-w-2xl">
      <h1 class="text-3xl lg:text-5xl font-display font-extrabold text-white leading-tight mb-4">Our Services</h1>
      <p class="text-white/80 text-lg">Comprehensive family medicine for every stage of life — all under one roof in Oklahoma City.</p>
    </div>
  </section>

  <ServicesGrid showViewAll={false} />

  <CallToAction />
</BaseLayout>
