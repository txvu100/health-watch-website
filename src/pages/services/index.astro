---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ServicesGrid from '../../components/sections/ServicesGrid.astro'
import CallToAction from '../../components/sections/CallToAction.astro'
import { CLINIC } from '../../data/clinic'
import { SERVICES, serviceHref, serviceTitle } from '../../data/services'

// ItemList tells search engines this is the hub for the 10 service pages
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Medical Services at Health Watch Medical Clinic',
  itemListElement: SERVICES.map((service, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: serviceTitle(service, 'en'),
    url: `${CLINIC.siteUrl}${serviceHref(service, 'en')}`,
  })),
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${CLINIC.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${CLINIC.siteUrl}/services/` },
  ],
}
---

<BaseLayout
  title="Medical Services | Health Watch Medical Clinic"
  description="Family medicine services in Oklahoma City: blood pressure, diabetes, women's health, immigration exams, physicals & telemedicine. Call (405) 949-1552."
  canonical={`${CLINIC.siteUrl}/services/`}
  esPath="/servicios"
  schemas={[breadcrumbSchema, itemListSchema]}
>
  <section class="relative overflow-hidden" style="background:linear-gradient(180deg,#FFFFFF 0%,#F3F0FB 100%)">
    <div class="container max-w-2xl py-14 lg:py-20">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="w-[7px] h-[7px] rounded-full bg-secondary"></span>
        <span class="text-[13px] font-extrabold tracking-[1.8px] uppercase text-[#8983B8]">Our services</span>
      </div>
      <h1 class="text-[32px] sm:text-[38px] lg:text-[47px] font-display font-extrabold tracking-[-1.2px] text-neutral-900 mb-4">Care for every stage of family life</h1>
      <p class="text-lg leading-[1.7] font-medium text-neutral-600">Comprehensive family medicine for every stage of life — all under one roof in Oklahoma City.</p>
    </div>
  </section>

  <ServicesGrid showViewAll={false} />

  <CallToAction />
</BaseLayout>
