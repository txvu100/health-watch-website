---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/sections/Hero.astro'
import InsuranceStrip from '../components/sections/InsuranceStrip.astro'
import ServicesGrid from '../components/sections/ServicesGrid.astro'
import WhyChooseUs from '../components/sections/WhyChooseUs.astro'
import LocationMap from '../components/sections/LocationMap.astro'
import CallToAction from '../components/sections/CallToAction.astro'
import FAQ from '../components/sections/FAQ.astro'
import { HOMEPAGE_FAQS } from '../data/faq'
import { CLINIC } from '../data/clinic'

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOMEPAGE_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
}
---

<BaseLayout
  title="Health Watch Medical Clinic | Family Doctor Oklahoma City"
  description="Health Watch Medical Clinic in Oklahoma City offers family medicine, blood pressure, diabetes, women's health, immigration exams & more. Walk-ins welcome. SoonerCare accepted. Call (405) 949-1552."
  canonical={CLINIC.siteUrl}
  esPath="/"
  schemas={[faqSchema]}
>
  <Hero />
  <InsuranceStrip />
  <ServicesGrid limit={8} />
  <WhyChooseUs />

  <!-- FAQ Section -->
  <section class="py-16 lg:py-24 bg-neutral-50 border-t border-neutral-200">
    <div class="container max-w-3xl">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-display font-bold text-neutral-900 mb-3">Frequently Asked Questions</h2>
        <p class="text-neutral-600">Quick answers to our most common questions.</p>
      </div>
      <FAQ faqs={HOMEPAGE_FAQS} />
    </div>
  </section>

  <LocationMap />
  <CallToAction />
</BaseLayout>
